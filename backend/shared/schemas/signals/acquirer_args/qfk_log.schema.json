{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "timeout": {
      "$ref": "https://hci-troubleshoot/schemas/signals/acquirer_args/common_args.schema.json#/properties/timeout"
    },
    "resource_keyword": {
      "type": "string",
      "description": "资源/主题选择器（acli log get <topic>）；改名消歧，非匹配关键词"
    },
    "host": {
      "type": "string",
      "description": "采集目标主机/作用域（如 {{HOST}}），特殊值 cluster 表示遍历集群"
    },
    "file": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_.-]|\\{\\{[A-Z][A-Z0-9_]*(?:\\.[A-Z0-9_]+)*\\}\\})+$",
      "description": "安全日志文件 basename（acli -f；禁止目录与控制字符，扩展名不限）"
    },
    "path": {
      "type": "string",
      "description": "路径（日志目录/文件等）"
    },
    "time_window": {
      "type": "string",
      "description": "时间窗（如 now/-1h）"
    },
    "instruction": {
      "type": "string",
      "description": "信号语义说明（acli 调用的人类可读解释）"
    }
  },
  "required": [
    "file"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hci-troubleshoot/schemas/signals/acquirer_args/qfk_log.schema.json",
  "title": "acquire.args for qfk_log"
}
