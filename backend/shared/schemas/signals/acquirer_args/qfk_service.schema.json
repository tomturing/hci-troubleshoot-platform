{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "timeout": {
      "$ref": "https://hci-troubleshoot/schemas/signals/acquirer_args/common_args.schema.json#/properties/timeout"
    },
    "host": {
      "type": "string",
      "description": "采集目标主机/作用域（如 {{HOST}}），特殊值 cluster 表示遍历集群"
    },
    "resource_keyword": {
      "type": "string",
      "description": "服务名选择器（acli service <container> <name>）；改名消歧"
    },
    "container": {
      "type": "string",
      "enum": [
        "anet",
        "asv",
        "host"
      ],
      "default": "asv",
      "description": "当前版本 aCLI 已探测服务组：asv(vt)/anet(vn)/host；领域 Catalog 另含 asan(vs)，当前节点未暴露，禁止假定可执行"
    },
    "command": {
      "type": "string",
      "description": "操作子命令（如 status/restart）"
    },
    "instruction": {
      "type": "string",
      "description": "信号语义说明（acli 调用的人类可读解释）"
    }
  },
  "required": [
    "resource_keyword"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hci-troubleshoot/schemas/signals/acquirer_args/qfk_service.schema.json",
  "title": "acquire.args for qfk_service"
}
