[
  {"note":  "性能专项"},
  {"note":  "1.配置文件"},
  {"action": "copy", "path": "/cfs/*"},
  {"action": "copy", "path": "/sf/cfg/*"},
  {"action": "copy", "path": "/tmp/gpu.info"},
  {"action": "copy", "path": "/etc/hostname"},
  {"action": "copy", "path": "/sf/version"},
  {"action": "copy", "path": "/boot/firmware/history"},

  {"note":  "2.日志文件"},
  {"action": "copy", "path": "/sf/log/{date}/sfvtk_all.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/kernel.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/vs/log/glusterfs/glusterfs_nfs.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/vs/log/glusterfs/api/gluster_tgtd.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/vs/log/glusterfs/api/vhost_tgt.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/vs/log/glusterfs/bricks/glusterfsd_sf-data-vs-local-*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/vs/tierd/tierd.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/vs/scripts/abnormal_diskstate.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/iscsid.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/multipath.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/dataplane.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/corosync.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/mce.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/sfvt_numa-server.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/ce_monitor.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/log/{date}/raid_monitor.log*", "date_placeholders": [{"placeholder": "{date}", "format": "%d"}]},
  {"action": "copy", "path": "/sf/data/local/performance_tools/check_result/*"},
  {"action": "copy", "path": "/sf/data/local/performance_tools/performance_data/*"},
  {"action": "copy", "path": "/sf/log/blackbox/{date}/*", "date_placeholders": [{"placeholder": "{date}", "format": "%Y%m%d"}]},

  {"note":  "3.执行命令"},
  {"action": "command", "path": "cat /sys/devices/system/clocksource/clocksource0/current_clocksource", "save_name": "current_clocksource.txt"},
  {"action": "command", "path": "top -b -n 2"},
  {"action": "command", "path": "echo -e \"numa-server\\nshow numa\\nshow vminfo\\nshow cgroup\" | proc_debug", "save_name": "proc_debug.txt", "use_bash": true},
  {"action": "command", "path": "/sf/bin/get_turbostat.sh", "save_name": "get_turbostat.txt"},
  {"action": "command", "path": "perf bench mem memcpy; perf bench mem memset", "save_name": "perf_bench.txt"},
  {"action": "command", "path": "iscsiadm -m session"},
  {"action": "command", "path": "for i in {1..5}; do dpdebug 4; sleep 1; done", "docker": "vn-agent", "save_name": "dpdebug.txt"},
  {"action": "command", "path": "grep \"[0-9]\" /sys/devices/system/edac/mc/mc*/csrow*/ch*", "save_name": "devices_mc_csrow_ch.txt"},
  {"action": "command", "path": "cat /sys/class/fc_host/host*/statistics/*", "save_name": "fc_host_statistics.txt"},
  {"action": "command", "path": "/sf/vs/bin/vs_iostat -c 5", "docker": "vs", "save_name": "vs_iostat_c_5.txt"},
  {"action": "command", "path": "uname -a"},
  {"action": "command", "path": "ls -l /sys/class/net/"},
  {"action": "command", "path": "lspci -vvv"},
  {"action": "command", "path": "echo -n \"show interface-take-over\" | cli", "docker": "vn-agent", "save_name": "interface_take_over.txt"},


  {"note":  "4.操作、告警日志"},
  {"action": "copy", "path": "/sf/log/log_new.db"}
]
