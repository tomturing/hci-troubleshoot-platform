# raw_to_sop 配置文件示例
# 复制此文件为 .env 并填写真实值：
#   cp .env.example .env

# kb-service 地址
# - Docker Compose 本地：http://localhost:8004
# - K3s 端口转发：kubectl port-forward svc/kb-service -n hci-staging 8004:8004
KB_SERVICE_URL=http://localhost:8004

# 内部 API Token（从 K3s Secret 获取）
# kubectl exec -n hci-staging deploy/kb-service -- env | grep INTERNAL_API_TOKEN
INTERNAL_API_TOKEN=

# HTTP 请求超时（秒，默认 120）
# API_TIMEOUT=120
