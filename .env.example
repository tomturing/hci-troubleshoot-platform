# =============================================================================
# HCI 智能排障平台 - 环境变量模板
# =============================================================================
# 用法：
#   cp .env.example .env
#   然后按需修改敏感值（密码、Token、API Key 等）
#
# 变量加载优先级（高→低）：
#   1. docker-compose.yml 中的 environment 显式覆盖
#   2. .env 文件（被 docker-compose 自动读取）
#   3. backend/*/app/config.py 中的 pydantic-settings 默认值
#
# Tips：
#   - 生产环境请务必替换所有 *_PASSWORD / *_TOKEN / *_KEY
#   - K8s 部署时，敏感值走 Secret，非敏感值走 ConfigMap
# =============================================================================

# ======================== 数据库 (PostgreSQL 15) ============================
POSTGRES_DB=hci_troubleshoot
POSTGRES_USER=hci_admin
POSTGRES_PASSWORD=dev_password_123

# asyncpg 连接串（后端微服务使用）
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# libpq 连接串（psql / Atlas 数据库迁移专用，不得包含 +asyncpg）
MIGRATION_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
MIGRATION_DEV_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/atlas_dev?sslmode=disable

# ======================== 缓存 (Redis 7) ===================================
REDIS_URL=redis://redis:6379/0

# ======================== 后端微服务端口 ====================================
API_GATEWAY_PORT=8000
CASE_SERVICE_PORT=8001
CONVERSATION_SERVICE_PORT=8002
SCHEDULER_SERVICE_PORT=8003
KB_SERVICE_PORT=8004
AGENT_SERVICE_PORT=8005

# ======================== 服务间通信地址 ====================================
# Docker Compose / K8s 内部 DNS（api-gateway 调用下游服务使用）
CASE_SERVICE_URL=http://case-service:8001
CONVERSATION_SERVICE_URL=http://conversation-service:8002
SCHEDULER_SERVICE_URL=http://scheduler-service:8003
KB_SERVICE_URL=http://kb-service:8004
AGENT_SERVICE_URL=http://agent-service:8005
DIAGNOSIS_SERVICE_URL=http://diagnosis-service:8008
DSH_SERVICE_URL=http://dsh:8080
# 旧 DSH 管理台 iframe 的同源路径；必须与旧实例的 public-url/Ingress path 一致。
DSH_PUBLIC_PATH=/dsh/
# 新 DSH token API 访问的独立 Service 地址；api-gateway 只在集群内访问该地址。
DSH_OFFLINE_SERVICE_URL=http://dsh-offline:8080
# 新 DSH 管理台 iframe 的同源路径；必须与新实例的 public-url/Ingress path 一致。
DSH_OFFLINE_PUBLIC_PATH=/dsh-offline/
DIAGNOSIS_IDENTITY_MODE=internal
# 安全重构 L1：删除 DIAGNOSIS_DEV_TENANT_ID/DIAGNOSIS_DEV_ACTOR_ID——管理台身份上下文
# （X-Tenant-ID/X-Actor-ID）改由网关从 admin JWT 派生，Nginx/Compose 不再注入，本地亦移除。
OIDC_PUBLIC_KEY_PEM_B64=
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
DIAGNOSIS_DIRECT_UPLOAD_BASE_URL=/
# 浏览器分片直传的显式 Origin（来源）白名单，逗号分隔；禁止使用 *。
DIAGNOSIS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
# 精简 P0 默认关闭；仅在完整补采页面和 Run #2 验收完成后启用。
DIAGNOSIS_ENABLE_AUTOMATIC_SUPPLEMENT=false
# 本地执行 `make diagnosis-dev-keys` 自动生成并持久化 RSA-3072 私钥；生产必须使用 KMS/Secret。
DIAGNOSIS_ENCRYPTION_PRIVATE_KEY_B64=
DIAGNOSIS_ENCRYPTION_KEY_ID=
# 服务间内部 API 鉴权 Token
INTERNAL_API_TOKEN=hci-dev-internal-token
# Diagnosis Service（诊断服务）Collector Artifact（采集器制品）Ed25519 签名配置。
# 私钥为 32 字节原始私钥的 Base64；生产环境必须由密钥管理系统注入，禁止提交真实值。
# 本地留空时 Docker Compose 使用公开的确定性开发密钥；该密钥不得建立生产信任。
COLLECTOR_SIGNING_PRIVATE_KEY_B64=
COLLECTOR_SIGNING_KEY_ID=

# ======================== OpenClaw / AI 模型 ================================
AI_DEFAULT_ASSISTANT_TYPE=htp-agent
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_DEFAULT_MODEL=deepseek-v4-flash
GLM_MODEL=deepseek-v4-flash
# LLM 推理参数（SOP + ReAct 排障推荐低温度保证工具调用确定性）
LLM_TEMPERATURE=0.1
LLM_TEMPERATURE_S0=0.3
LLM_TEMPERATURE_REACT=0.0
LLM_TOP_P=0.3
LLM_LOGPROBS=false
LLM_TOP_LOGPROBS=0

# --- KBD 分类 (Stage 4) ---
# 未配置时回退到 LLM_BASE_URL / LLM_API_KEY
CLASSIFY_BASE_URL=
CLASSIFY_API_KEY=
CLASSIFY_MODEL=qwen2.5:32b
CLASSIFY_MAX_TOKENS=2048

# --- KBD 信号抽取 (Stage 5) ---
# 未配置时回退到 CLASSIFY_MODEL → qwen3.7-plus
# URL/Key 未配置时回退到 LLM_BASE_URL / LLM_API_KEY
EXTRACT_SIGNALS_MODEL=
KBD_BATCH_STALE_AFTER_SECONDS=600
EXTRACT_SIGNALS_BASE_URL=
EXTRACT_SIGNALS_API_KEY=
# 长输出预算和 JSON 格式纠错次数；长度截断不会按相同策略重复调用
EXTRACT_SIGNALS_MAX_TOKENS=16384
EXTRACT_SIGNALS_FORMAT_MAX_ATTEMPTS=2

# --- KBD 截图识图 (Stage 3) ---
# 未配置时回退到 LLM_BASE_URL / LLM_API_KEY / kimi-k2.5
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
VISION_MODEL=frob/unlimited-ocr:f16
VISION_MAX_TOKENS=1536
# 单次模型请求超时（秒）；Ollama 大模型冷启动时可按机器性能调大
LLM_TIMEOUT=120.0
# KBD 分类、识图、信号抽取共享的全局并发上限
VISION_GLOBAL_CONCURRENCY=3
LLM_GLOBAL_CONCURRENCY=3
# 业务层总尝试次数；OpenAI SDK 内部重试已关闭，避免次数相乘
VISION_LLM_MAX_ATTEMPTS=2
LLM_ENABLE_THINKING=false

# 功能开关
REACT_ENABLED=false
KB_ENABLED=true
ASSISTANT_REGISTRY_JSON='{"openclaw":{"base_url":"https://api.deepseek.com","api_key":"","model":"deepseek-v4-flash","enabled":true},"htp-agent":{"base_url":"https://api.deepseek.com","api_key":"","model":"deepseek-v4-flash","enabled":true}}'

# ======================== 可观测性 (OpenTelemetry) ==========================
# OTLP gRPC 端点（Tempo 接收器）
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
LOG_LEVEL=INFO

# ======================== Grafana ==========================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ======================== LangFuse ==========================================
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://langfuse-server:3000/
# 默认展示经过字段级脱敏的业务输入输出，才能复盘 Prompt、模型响应和同步差异
LANGFUSE_CAPTURE_CONTENT=true
# 信号抽取审核需要查看脱敏后的 Prompt 和 JSON；可单独关闭而不影响其他观测
LANGFUSE_CAPTURE_EXTRACT_SIGNALS_CONTENT=true

# ======================== Scheduler / K8s ==================================
K8S_NAMESPACE=hci-troubleshoot
WARM_POOL_SIZE=2
MAX_POOL_SIZE=10
POD_IDLE_TIMEOUT=300
# 多助手注册表（供 scheduler-service 与 conversation-service 统一读取）
# ZeroClaw 默认 require_pairing=true，需先执行配对获取 token：
#   curl -s -X POST http://localhost:42617/pair -H "X-Pairing-Code: <控制台显示的一次性配对码>"
# 返回 JSON 中的 token 填到 zeroclaw.gateway_token。
# 示例（单行 JSON，openclaw + zeroclaw，并集字段，兼容调度 + 对话服务）:
# ASSISTANT_REGISTRY_JSON={"openclaw":{"name":"OpenClaw","description":"通用AI排障助手","image":"openclaw:latest","port":18789,"warm_pool_size":2,"max_pool_size":10,"enabled":true,"base_url":"http://openclaw:18789","gateway_token":"hci-dev-openclaw-token","model":"openclaw","labels":{"app":"openclaw","assistant-type":"openclaw"}},"zeroclaw":{"name":"ZeroClaw","description":"ZeroClaw Rust 网关","image":"zeroclaw:latest","port":42617,"warm_pool_size":1,"max_pool_size":5,"enabled":true,"base_url":"http://zeroclaw:42617","gateway_token":"<zeroclaw_pair_token>","model":"zeroclaw","labels":{"app":"zeroclaw","assistant-type":"zeroclaw"}}}
# 三方助手（picoclaw/nanobot/nanoclaw）可通过 CLI Adapter 接入，详见：
#   docs/12_三方助手Adapter接入指南.md

# ======================== 前端 =============================================
# CORS 允许的来源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
# Vite dev proxy 目标（仅本地开发使用）
VITE_API_BASE_URL=http://localhost:8000
# Terminal Bridge（终端桥接服务）运行时地址；留空时使用桌面端 localhost 默认地址
TERMINAL_BRIDGE_URL=
# Terminal Bridge（终端桥接服务）单次命令执行超时，单位为秒
TERMINAL_BRIDGE_EXEC_TIMEOUT_SECONDS=120

# ======================== DSH（DeepSeek Harness）============================
# DSH 通过管理台同源 /dsh 访问；Compose 中 dsh-proxy 对外发布宿主机 3080。
# DSH profile 名称；通常为 web。
DSH_PROFILE=web
# 旧 DSH 对外访问根地址，需包含 /dsh/ 且必须是绝对 URL。
DSH_PUBLIC_URL=http://localhost:3002/dsh/
# 旧 DSH 接受的 Host/Origin 主机名；不要填写带协议或路径的值。
DSH_TRUSTED_HOST=localhost
# 管理台 Nginx 反代旧 DSH 的上游地址。
DSH_UPSTREAM=http://dsh:8080
# 旧 DSH 使用的 LLM API Key；密钥只放本地 .env，不要提交到仓库。
DSH_QWEN_API_KEY=
# 旧 DSH 读取的客户日志宿主机目录，挂载到容器 /data/customer-logs，只读。
DSH_CUSTOMER_LOGS_PATH=../../dsh/data/customer-logs
# 旧 DSH 读取的工单宿主机目录，挂载到容器 /data/tickets，只读。
DSH_TICKETS_PATH=../../dsh/data/tickets
# 旧 DSH 的 LLM provider 标识。
DSH_LLM_PROVIDER_ID=aliyun-maas
# 旧 DSH 的 LLM API 协议类型。
DSH_LLM_API=openai-completions
# 旧 DSH 的 OpenAI 兼容 LLM Base URL。
DSH_LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 旧 DSH 使用的模型名称。
DSH_LLM_MODEL=qwen3.8-flash
# 旧 DSH 安装的插件 bundle，使用历史版本保持现网 profile 兼容。
DSH_PLUGIN_PACKAGES=/opt/dsh-plugins/deepseek-harness-wecom-offline-0.1.22.tgz
# 旧 DSH 的企业微信机器人 ID。
WECOM_BOT_ID=
# 旧 DSH 的企业微信机器人 Secret；不要提交真实值。
WECOM_BOT_SECRET=
# 旧 DSH 的 WeCom 工作区容器内路径。
WECOM_WORKSPACE_ROOT=/work/wecom

# 新 HCI 单 Agent DSH 的完整独立配置；这些变量不与上面的旧实例共享。
# 新 DSH profile 名称；通常为 web。
DSH_OFFLINE_PROFILE=web
# 管理台 Nginx 反代新 DSH 的独立上游地址。
DSH_OFFLINE_UPSTREAM=http://dsh-offline:8080
# 新 DSH 对外访问根地址，需包含 /dsh-offline/ 且必须是绝对 URL。
DSH_OFFLINE_PUBLIC_URL=http://localhost:3002/dsh-offline/
# 新 DSH 接受的 Host/Origin 主机名；不要填写带协议或路径的值。
DSH_OFFLINE_TRUSTED_HOST=localhost
# 新 DSH 使用的独立 LLM API Key；不复用旧 DSH_QWEN_API_KEY。
DSH_OFFLINE_QWEN_API_KEY=
# 新 DSH 读取的客户日志宿主机目录，挂载到容器 /data/customer-logs，只读。
DSH_OFFLINE_CUSTOMER_LOGS_PATH=../../dsh/data/customer-logs
# 新 DSH 读取的工单宿主机目录，只读挂载到 DSH_OFFLINE_WECOM_WORKSPACE_ROOT 指定的容器路径。
DSH_OFFLINE_TICKETS_PATH=../../dsh/data/tickets
# 新 DSH 的 LLM provider 标识。
DSH_OFFLINE_LLM_PROVIDER_ID=aliyun-maas
# 新 DSH 的 LLM API 协议类型。
DSH_OFFLINE_LLM_API=openai-completions
# 新 DSH 的 OpenAI 兼容 LLM Base URL。
DSH_OFFLINE_LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 新 DSH 使用的模型名称。
DSH_OFFLINE_LLM_MODEL=qwen3.8-flash
# 新 DSH 安装的精确本地 tgz；空格分隔，三项必须作为同一个 profile 安装。
DSH_OFFLINE_PLUGIN_PACKAGES="/opt/dsh-plugins/deepseek-harness-wecom-0.1.33.tgz /opt/dsh-plugins/deepseek-harness-session-bi-0.1.21.tgz /opt/dsh-plugins/hci-offline-diagnosis-bundle-0.4.1.tgz"
# 新 DSH 的企业微信机器人 ID。
DSH_OFFLINE_WECOM_BOT_ID=
# 新 DSH 的企业微信机器人 Secret；不要提交真实值。
DSH_OFFLINE_WECOM_BOT_SECRET=
# 新 DSH 的 WeCom 工作区容器内路径；必须与工单卷的容器挂载目标一致。
DSH_OFFLINE_WECOM_WORKSPACE_ROOT=/data/tickets
# 新 DSH 的规则包工作区；用于 Session BI 物化工单规则。
DSH_OFFLINE_WECOM_RULE_WORKSPACE_ROOT=/home/dsh/.dsh/session-bi/work-ticket-rules
# 新 DSH 的 WeCom 会话默认 Agent Preset。
DSH_OFFLINE_WECOM_AGENT_PRESET=hci-offline
# 新 DSH 的 HCI 知识库根目录，供 hci-offline-diagnosis-bundle 查询。
DSH_OFFLINE_HCI_KNOWLEDGE_ROOT=/data/tickets/knowledge
