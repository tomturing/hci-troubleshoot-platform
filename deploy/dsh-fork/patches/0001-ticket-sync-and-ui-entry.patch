diff --git a/packages/client/ui-ticket-sync/src/client/TicketSyncDialog.tsx b/packages/client/ui-ticket-sync/src/client/TicketSyncDialog.tsx
new file mode 100644
index 00000000..6d12c659
--- /dev/null
+++ b/packages/client/ui-ticket-sync/src/client/TicketSyncDialog.tsx
@@ -0,0 +1,262 @@
+/**
+ * 工单号对话框：输入 → 进度 → 就位，三段在同一面板里推进。
+ *
+ * 为什么不自动关闭也不做多步向导：整个过程是一个不可中断的长任务，
+ * 操作者需要看到"传到多少、解到第几层、为什么失败"；一次误关就意味着
+ * 重新传一个可能上 G 的包。
+ * @module @deepseek-ai/dsh-client-ui-ticket-sync/client/TicketSyncDialog
+ */
+
+import { useCallback, useEffect, useRef, useState } from 'react'
+import type { TicketFrame, TicketPhase } from './protocol.ts'
+import type { DirectoryFlowOwnerProps, TicketFlowInjected } from './flow.ts'
+
+/** 与服务端同一条正则：本地先挡一次，避免无谓往返。 */
+const TICKET_ID_PATTERN = /^Q\d{13}$/
+
+/** 日志区保留的行数。 */
+const MAX_LOG_LINES = 8
+
+const styles = {
+  mask: {
+    position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.45)',
+    display: 'flex', alignItems: 'center', justifyContent: 'center', zIndex: 1000,
+  },
+  panel: {
+    width: 'min(560px, 92vw)', background: 'var(--dsh-surface, #fff)', color: 'var(--dsh-text, #111)',
+    borderRadius: 12, padding: 20, boxShadow: '0 12px 40px rgba(0,0,0,0.25)',
+    display: 'flex', flexDirection: 'column', gap: 12, font: 'inherit',
+  },
+  title: { fontSize: 16, fontWeight: 600, margin: 0 },
+  hint: { fontSize: 12, opacity: 0.65, margin: 0, lineHeight: 1.5 },
+  field: { display: 'flex', flexDirection: 'column', gap: 6 },
+  label: { fontSize: 12, opacity: 0.75 },
+  input: {
+    padding: '8px 10px', borderRadius: 8, border: '1px solid rgba(128,128,128,0.4)',
+    background: 'transparent', color: 'inherit', fontSize: 14, fontFamily: 'monospace',
+  },
+  row: { display: 'flex', gap: 8, justifyContent: 'flex-end', alignItems: 'center' },
+  button: {
+    padding: '7px 14px', borderRadius: 8, border: '1px solid rgba(128,128,128,0.4)',
+    background: 'transparent', color: 'inherit', cursor: 'pointer', fontSize: 13,
+  },
+  primary: { background: 'var(--dsh-accent, #2563eb)', color: '#fff', borderColor: 'transparent' },
+  bar: { height: 6, borderRadius: 3, background: 'rgba(128,128,128,0.25)', overflow: 'hidden' },
+  barFill: { height: '100%', background: 'var(--dsh-accent, #2563eb)', transition: 'width 0.2s' },
+  log: {
+    margin: 0, padding: 10, borderRadius: 8, background: 'rgba(128,128,128,0.12)',
+    fontSize: 11, lineHeight: 1.6, fontFamily: 'monospace', maxHeight: 140, overflow: 'auto',
+  },
+  alert: { fontSize: 13, color: '#b91c1c', margin: 0 },
+} satisfies Record<string, React.CSSProperties>
+
+/** 面板所处的外部阶段（与服务端 `TicketPhase` 分开：这里还含输入与错误）。 */
+type Stage = 'input' | 'running' | 'done' | 'error'
+
+/** 字节数的可读形式。 */
+function formatBytes(bytes: number): string {
+  if (bytes >= 1024 ** 3) return `${(bytes / 1024 ** 3).toFixed(2)} GiB`
+  if (bytes >= 1024 ** 2) return `${(bytes / 1024 ** 2).toFixed(1)} MiB`
+  if (bytes >= 1024) return `${(bytes / 1024).toFixed(1)} KiB`
+  return `${String(bytes)} B`
+}
+
+/** 阶段的中文名（首版只带中文，locale 化留到接入 i18n 时统一）。 */
+const PHASE_LABEL: Record<TicketPhase, string> = {
+  queued: '排队中',
+  verifying: '正在校验远端与容量',
+  syncing: '正在同步压缩包',
+  extracting: '正在递归解压',
+  ready: '已就位',
+  failed: '失败',
+  cancelled: '已取消',
+}
+
+/**
+ * 工单入口对话框。
+ * @param props - owner 分享（`open`/`onPicked`/`onCancel`）与本包注入的动词。
+ */
+export function TicketSyncDialog(props: DirectoryFlowOwnerProps & TicketFlowInjected) {
+  const { open, onPicked, onCancel, submit, follow, cancel, t } = props
+  const [stage, setStage] = useState<Stage>('input')
+  const [ticketId, setTicketId] = useState('')
+  const [password, setPassword] = useState('')
+  const [phase, setPhase] = useState<TicketPhase>('queued')
+  const [bytes, setBytes] = useState(0)
+  const [total, setTotal] = useState<number | undefined>(undefined)
+  const [files, setFiles] = useState(0)
+  const [logs, setLogs] = useState<string[]>([])
+  const [error, setError] = useState<string | undefined>(undefined)
+  const jobRef = useRef<string | undefined>(undefined)
+  const abortRef = useRef<AbortController | undefined>(undefined)
+  const aliveRef = useRef(true)
+
+  // 每次打开都从干净状态开始：上一次的进度与错误不该污染这一次。
+  useEffect(() => {
+    if (!open) return
+    setStage('input')
+    setPhase('queued')
+    setBytes(0)
+    setTotal(undefined)
+    setFiles(0)
+    setLogs([])
+    setError(undefined)
+    jobRef.current = undefined
+  }, [open])
+
+  // 卸载时断开订阅：任务本身继续跑（重进页面能恢复），只是界面不再等待。
+  useEffect(() => {
+    aliveRef.current = true
+    return () => {
+      aliveRef.current = false
+      abortRef.current?.abort()
+    }
+  }, [])
+
+  const valid = TICKET_ID_PATTERN.test(ticketId)
+
+  /** 把一帧投影到界面状态。 */
+  const applyFrame = useCallback((frame: TicketFrame) => {
+    switch (frame.kind) {
+      case 'status':
+        setPhase(frame.phase)
+        break
+      case 'log':
+        setLogs(previous => [...previous, frame.chunk].slice(-MAX_LOG_LINES))
+        break
+      case 'progress':
+        setBytes(frame.bytes)
+        setFiles(frame.files)
+        if (frame.total !== undefined) setTotal(frame.total)
+        break
+      default:
+        break
+    }
+  }, [])
+
+  /** 提交并订阅。这是整个对话框唯一的副作用入口。 */
+  const start = useCallback(async () => {
+    setStage('running')
+    setError(undefined)
+    setLogs([])
+    setBytes(0)
+    setFiles(0)
+    setTotal(undefined)
+    try {
+      const job = await submit({
+        ticketId,
+        ...(password === '' ? {} : { password }),
+      })
+      jobRef.current = job.jobId
+      setPhase(job.phase as TicketPhase)
+      const controller = new AbortController()
+      abortRef.current = controller
+      for await (const frame of follow(job.jobId, controller.signal)) {
+        if (!aliveRef.current) return
+        applyFrame(frame)
+        if (frame.kind === 'done') {
+          setStage('done')
+          // 需求 4：就位后自动把它设为 workspace 目录（owner 负责登记与会话切换）。
+          onPicked(frame.extractedPath)
+          return
+        }
+        if (frame.kind === 'failed') {
+          setError(frame.message)
+          setStage('error')
+          return
+        }
+      }
+      // 流结束却没有终态帧：连接断了，任务可能还在跑。
+      if (aliveRef.current) {
+        setError(t('disconnected'))
+        setStage('error')
+      }
+    } catch (failure: unknown) {
+      if (!aliveRef.current) return
+      setError(failure instanceof Error ? failure.message : String(failure))
+      setStage('error')
+    }
+  }, [applyFrame, follow, onPicked, password, submit, t, ticketId])
+
+  /** 取消：先发请求，再立即断开订阅（等终态帧会让按钮看起来失灵）。 */
+  const stop = useCallback(async () => {
+    const jobId = jobRef.current
+    abortRef.current?.abort()
+    setStage('input')
+    if (jobId === undefined) return
+    await cancel(jobId).catch(() => undefined)
+  }, [cancel])
+
+  if (!open) return null
+
+  const percent = total !== undefined && total > 0 ? Math.min(100, Math.round((bytes / total) * 100)) : undefined
+
+  return (
+    <div style={styles.mask} role="presentation">
+      <div style={styles.panel} role="dialog" aria-modal="true" aria-label={t('title')}>
+        <h2 style={styles.title}>{t('title')}</h2>
+        <p style={styles.hint}>{t('hint')}</p>
+
+        <label style={styles.field}>
+          <span style={styles.label}>{t('ticketId')}</span>
+          <input
+            style={styles.input}
+            value={ticketId}
+            placeholder="Q2026012500018"
+            disabled={stage === 'running'}
+            onChange={(event) => { setTicketId(event.target.value.trim()) }}
+          />
+        </label>
+
+        <label style={styles.field}>
+          <span style={styles.label}>{t('password')}</span>
+          <input
+            style={styles.input}
+            type="password"
+            value={password}
+            placeholder={t('passwordPlaceholder')}
+            disabled={stage === 'running'}
+            onChange={(event) => { setPassword(event.target.value) }}
+          />
+        </label>
+
+        {stage === 'running' || stage === 'done' ? (
+          <div style={styles.field}>
+            <span style={styles.label}>
+              {PHASE_LABEL[phase]}
+              {percent === undefined ? '' : ` · ${String(percent)}%`}
+              {bytes > 0 ? ` · ${formatBytes(bytes)}` : ''}
+              {files > 0 ? ` · ${String(files)} 个文件` : ''}
+            </span>
+            <div style={styles.bar}>
+              <div style={{ ...styles.barFill, width: `${String(percent ?? 8)}%` }} />
+            </div>
+            {logs.length > 0 ? <pre style={styles.log}>{logs.join('\n')}</pre> : null}
+          </div>
+        ) : null}
+
+        {error === undefined ? null : <p style={styles.alert} role="alert">{error}</p>}
+
+        <div style={styles.row}>
+          {stage === 'running' ? (
+            <button style={styles.button} type="button" onClick={() => { void stop() }}>
+              {t('cancel')}
+            </button>
+          ) : (
+            <button style={styles.button} type="button" onClick={onCancel}>
+              {t('close')}
+            </button>
+          )}
+          <button
+            style={{ ...styles.button, ...styles.primary }}
+            type="button"
+            disabled={!valid || stage === 'running'}
+            onClick={() => { void start() }}
+          >
+            {t('confirm')}
+          </button>
+        </div>
+      </div>
+    </div>
+  )
+}
diff --git a/packages/client/ui-ticket-sync/src/client/flow.ts b/packages/client/ui-ticket-sync/src/client/flow.ts
new file mode 100644
index 00000000..1734aa97
--- /dev/null
+++ b/packages/client/ui-ticket-sync/src/client/flow.ts
@@ -0,0 +1,56 @@
+/**
+ * 适配层：把 ui-workspace 的 owner 对话映射到工单对话框。
+ *
+ * 与 browse occupant 保持同一约定：失败留在对话框自身的告警面，不驱动
+ * owner 的 `onError` —— owner 的错误对话框带"重试/重选"语义，对"密码错"
+ * 这种需要原地改输入的失败并不合适。
+ * @module @deepseek-ai/dsh-client-ui-ticket-sync/client/flow
+ */
+
+import { createElement } from 'react'
+import type { TicketFrame } from './protocol.ts'
+import { TicketSyncDialog } from './TicketSyncDialog.tsx'
+
+/**
+ * 洞的 owner 分享（与 ui-workspace 的 `DirectoryFlowOwnerProps` 结构等价）。
+ *
+ * 刻意在本地声明而不是 import owner 包的类型：本包与 ui-workspace 是两个
+ * 独立编译项目，跨项目拉取 owner 的具名类型会触发 TS 的相对 import 重写检查
+ * （TS2878）。洞的 owner 契约本身是结构化的，形状一致即兼容。
+ */
+export interface DirectoryFlowOwnerProps {
+  /** 为 true 时渲染交互，翻回 false 表示撤回请求。 */
+  open: boolean
+  /** owner 正在采纳路径（createWorkspace 进行中）。 */
+  busy: boolean
+  /** 操作者选定了绝对路径，owner 负责登记。 */
+  onPicked: (path: string) => void
+  /** 操作者放弃本次交互。 */
+  onCancel: () => void
+  /** 交互本身失败时的说明文案。 */
+  onError: (message: string) => void
+}
+
+/** 本包对文案的取用面（locale 命名空间已绑定）。 */
+export type Translate = (key: string) => string
+
+/** 注入面：本包驱动的三个线上动词与文案。 */
+export interface TicketFlowInjected {
+  /** 提交同步，返回任务句柄；业务失败以拒绝表达。 */
+  submit: (request: { ticketId: string; password?: string }) => Promise<{ jobId: string; phase: string }>
+  /** 订阅进度流；`signal` 用于断开（不取消任务本身）。 */
+  follow: (jobId: string, signal: AbortSignal) => AsyncIterable<TicketFrame>
+  /** 请求取消任务。 */
+  cancel: (jobId: string) => Promise<void>
+  /** 本包命名空间的文案。 */
+  t: Translate
+}
+
+/**
+ * 工单入口的 occupant：owner 契约 + 本包注入面。
+ * @param props - 洞的 owner 分享与本包注入面。
+ * @returns 对话框元素（关闭时渲染空）。
+ */
+export function TicketSyncFlow(props: DirectoryFlowOwnerProps & TicketFlowInjected) {
+  return createElement(TicketSyncDialog, props)
+}
diff --git a/packages/client/ui-ticket-sync/src/client/index.ts b/packages/client/ui-ticket-sync/src/client/index.ts
new file mode 100644
index 00000000..e7e91a42
--- /dev/null
+++ b/packages/client/ui-ticket-sync/src/client/index.ts
@@ -0,0 +1,61 @@
+/**
+ * 工单入口的浏览器半边：把同一个对话框填进 ui-workspace 的两个洞
+ * （首屏 hero 与侧栏工作区），并通过 `remote.ticket` 驱动宿主侧长任务。
+ *
+ * 一个包同时占两个洞，是为了让"首屏"和"侧栏"永远展示同一个交互 ——
+ * 两份实现迟早会在文案、校验或错误处理上分叉。
+ * @module @deepseek-ai/dsh-client-ui-ticket-sync/client
+ */
+
+import type { Context as ClientContext } from '@deepseek-ai/cordis'
+// Type-only：拉入 SlotMap 合并，声明 ui-workspace 的两个工单洞。
+import type {} from '@deepseek-ai/dsh-client-ui-workspace/client'
+// Type-only：拉入 SlotRegistry 服务合并（ctx.slots）。
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+// Type-only：拉入 remote 服务的 `ticket` 命名空间类型。
+import type {} from '@deepseek-ai/dsh-api-remotes/client'
+// Type-only：拉入 typert 生成的 `TypertRemoteNamespaceMap` 增强，否则 ctx.remote.ticket 不存在。
+import type {} from '@deepseek-ai/dsh-api-ticket-sync/remote'
+import type { TicketFrame } from './protocol.ts'
+import type { TicketFlowInjected } from './flow.ts'
+import { TicketSyncFlow } from './flow.ts'
+
+import { ZH } from './locales.ts'
+
+/** 必需服务：槽注册表、工作区 UI，以及宿主的工单动词（`remote` 是 `remote.ticket` 的容器）。 */
+export const inject = ['slots', 'uiWorkspace', 'remote', 'remote.ticket']
+
+/**
+ * 客户端插件体：注册文案，再把对话框注入两个洞。
+ *
+ * 用 `slots.inject()` 而不是直接 `register`，因为 ui-workspace 的声明可能
+ * 晚于本包激活、也可能被替换 —— 直接 register 会在声明尚未落地时丢洞。
+ * @param ctx - 客户端根上下文。
+ */
+export function apply(ctx: ClientContext): void {
+  const injected = (): TicketFlowInjected => ({
+    submit: async (request) => {
+      const result = await ctx.remote.ticket.submit(request)
+      if (!result.ok) throw result.error
+      return result.value
+    },
+    follow: (jobId, signal): AsyncIterable<TicketFrame> => ctx.remote.ticket.follow({ jobId }, signal),
+    cancel: async (jobId) => {
+      const result = await ctx.remote.ticket.cancel({ jobId })
+      if (!result.ok) throw result.error
+    },
+    // 首版只出中文：直接查本地字典，避免为一个键值表引入跨项目类型依赖。
+    t: (key: string) => ZH[key] ?? key,
+  })
+
+  // 两个声明必须同时存活才安装这一对 occupant；generator 让它们成为一个事务。
+  ctx.slots.inject('conversation.hero.workspace.ticketFlow', () =>
+    ctx.slots.inject('sidebar.workspaces.ticketFlow', function* () {
+      yield ctx.slots.register({
+        name: 'conversation.hero.workspace.ticketFlow', inject: injected,
+      }, TicketSyncFlow)
+      yield ctx.slots.register({
+        name: 'sidebar.workspaces.ticketFlow', inject: injected,
+      }, TicketSyncFlow)
+    }))
+}
diff --git a/packages/client/ui-ticket-sync/src/client/locales.ts b/packages/client/ui-ticket-sync/src/client/locales.ts
new file mode 100644
index 00000000..8bd8b6b8
--- /dev/null
+++ b/packages/client/ui-ticket-sync/src/client/locales.ts
@@ -0,0 +1,22 @@
+/**
+ * 对话框的文案字典。
+ *
+ * 这里刻意不走 DSH 的 locale 服务：工单洞的 owner（ui-workspace）只把
+ * `t` 传给它自己的命名空间，洞的占位者拿不到当前语言；为一个"首版只出
+ * 中文"的对话框引入跨包语言依赖，代价高于收益。等需要中英双语时，再把
+ * 这层换成 `ctx.locale` 注册（届时键名按命名空间加 `ticket.` 前缀）。
+ * @module @deepseek-ai/dsh-client-ui-ticket-sync/client/locales
+ */
+
+/** 中文文案；键名与对话框的 `t('...')` 调用一一对应。 */
+export const ZH: Record<string, string> = {
+  title: '从工单号同步日志',
+  hint: '输入工单号后，会从 0.2 拉取该工单的日志压缩包、递归解压到本地，并把解压目录设为工作区。大工单可能需要数分钟，期间可以取消。',
+  ticketId: '工单号',
+  password: 'zip 密码',
+  passwordPlaceholder: '留空使用服务端默认密码',
+  confirm: '确定',
+  cancel: '取消同步',
+  close: '关闭',
+  disconnected: '进度连接已断开。任务可能仍在后台执行，可重新输入工单号查看结果。',
+}
diff --git a/packages/client/ui-ticket-sync/src/client/protocol.ts b/packages/client/ui-ticket-sync/src/client/protocol.ts
new file mode 100644
index 00000000..143a21a8
--- /dev/null
+++ b/packages/client/ui-ticket-sync/src/client/protocol.ts
@@ -0,0 +1,43 @@
+/**
+ * 进度协议在浏览器侧的结构声明。
+ *
+ * 为什么不在本地 import `@deepseek-ai/dsh-api-ticket-sync/types`：那是另一个
+ * 编译项目（api 包）的源文件，跨项目拉取具名类型会让 tsc 的
+ * `rewriteRelativeImportExtensions` 判定 import 路径"不安全重写"（TS2878），
+ * 因为两个项目的输出目录层级不同。协议本身是纯结构，形状一致即兼容 ——
+ * 真正的类型约束由 `ctx.remote.ticket` 的生成类型在调用点兜住。
+ * @module @deepseek-ai/dsh-client-ui-ticket-sync/client/protocol
+ */
+
+/** 一次同步任务所处的阶段。 */
+export type TicketPhase =
+  | 'queued'
+  | 'verifying'
+  | 'syncing'
+  | 'extracting'
+  | 'ready'
+  | 'failed'
+  | 'cancelled'
+
+/** 失败分类（与服务端闭集一一对应）。 */
+export type TicketErrorCode =
+  | 'ticket/invalid-id'
+  | 'ticket/not-found'
+  | 'ticket/too-large'
+  | 'ticket/insufficient-storage'
+  | 'ticket/bad-password'
+  | 'ticket/archive-corrupt'
+  | 'ticket/space-exceeded'
+  | 'ticket/too-many-files'
+  | 'ticket/busy'
+  | 'ticket/sync-failed'
+  | 'ticket/extract-failed'
+  | 'ticket/cancelled'
+
+/** 进度流的一帧；`done`/`failed` 是终态帧。 */
+export type TicketFrame =
+  | { kind: 'status'; phase: TicketPhase; startedAt: string }
+  | { kind: 'log'; chunk: string }
+  | { kind: 'progress'; bytes: number; total?: number; files: number }
+  | { kind: 'done'; extractedPath: string; bytes: number; durationMs: number }
+  | { kind: 'failed'; code: TicketErrorCode; message: string }
