diff --git a/scripts/verify-ticket-ui.mjs b/scripts/verify-ticket-ui.mjs
new file mode 100644
index 00000000..a767c837
--- /dev/null
+++ b/scripts/verify-ticket-ui.mjs
@@ -0,0 +1,125 @@
+/**
+ * 工单入口的 UI 冒烟验证：不依赖人眼，也不需要重新构建镜像。
+ *
+ * 前提：`pnpm dev:web` 已在跑（它会常驻 tsc/tsdown/vite 三个 watcher，
+ * 改完源码自动重编并让浏览器 reload）。本脚本只做"打开页面 → 点菜单 →
+ * 校验对话框"，全程 5 秒内，用来替代"改完代码 → 建镜像 → 部署 → 人点页面"。
+ *
+ * 用法：
+ *   node scripts/verify-ticket-ui.mjs                 # 自动从 /tmp/devweb.log 取入口
+ *   node scripts/verify-ticket-ui.mjs --url http://127.0.0.1:3080/?token=xxx
+ */
+import { execSync } from 'node:child_process'
+import { existsSync, readdirSync, readFileSync, statSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+
+/** 从 dev:web 日志里取最后一次启动地址（含 launch token）。 */
+function urlFromLog() {
+  const log = process.env.DSH_DEV_LOG ?? '/tmp/devweb.log'
+  if (!existsSync(log)) return undefined
+  const matches = [...readFileSync(log, 'utf8').matchAll(/dsh web: (\S+)/g)]
+  return matches.at(-1)?.[1]
+}
+
+/** 在 pnpm store 里找可用的 playwright（本仓库未把它提升到根 node_modules）。 */
+async function loadPlaywright() {
+  if (process.env.PLAYWRIGHT_MODULE !== undefined) return import(process.env.PLAYWRIGHT_MODULE)
+  const store = join(process.cwd(), 'node_modules/.pnpm')
+  const candidates = readdirSync(store)
+    .filter(name => /^playwright@\d/.test(name))
+    .sort()
+    .reverse()
+  for (const name of candidates) {
+    const entry = join(store, name, 'node_modules/playwright/index.mjs')
+    if (existsSync(entry)) return import(entry)
+  }
+  throw new Error('未找到 playwright：请在仓库根执行 pnpm install，或设置 PLAYWRIGHT_MODULE')
+}
+
+/** 找本机已安装的 chromium（避免再下载 150MB）。 */
+function chromiumPath() {
+  if (process.env.CHROMIUM_PATH !== undefined) return process.env.CHROMIUM_PATH
+  const cache = join(homedir(), '.cache/ms-playwright')
+  if (!existsSync(cache)) return undefined
+  for (const dir of readdirSync(cache)) {
+    if (!dir.startsWith('chromium-')) continue
+    for (const layout of ['chrome-linux64/chrome', 'chrome-linux/chrome']) {
+      const candidate = join(cache, dir, layout)
+      if (existsSync(candidate)) return candidate
+    }
+  }
+  return undefined
+}
+
+const url = process.argv.includes('--url')
+  ? process.argv[process.argv.indexOf('--url') + 1]
+  : urlFromLog()
+if (url === undefined) {
+  console.error('找不到开发服务器地址：请先 pnpm dev:web，或用 --url 显式指定')
+  process.exit(1)
+}
+
+const pw = await loadPlaywright()
+const browser = await pw.chromium.launch({
+  ...(chromiumPath() === undefined ? {} : { executablePath: chromiumPath() }),
+})
+const page = await browser.newPage({ viewport: { width: 1440, height: 900 } })
+const failures = []
+const check = (condition, message) => {
+  if (condition) console.log(`  ok   ${message}`)
+  else {
+    console.log(`  FAIL ${message}`)
+    failures.push(message)
+  }
+}
+
+try {
+  await page.goto(url, { waitUntil: 'networkidle', timeout: 90_000 })
+  await page.waitForTimeout(1500)
+  const skip = page.getByRole('button', { name: 'Continue' })
+  if (await skip.count() > 0) await skip.first().click()
+  for (let index = 0; index < 2; index += 1) await page.keyboard.press('Escape')
+  await page.waitForTimeout(400)
+
+  // 1) workspace 菜单里必须出现工单入口
+  const opened = await page.evaluate(() => {
+    const nodes = [...document.querySelectorAll('span,button,div')]
+      .filter(node => node.textContent?.trim() === 'Default workspace')
+    const button = nodes.at(-1)?.closest('button')
+    if (button === null || button === undefined) return false
+    button.click()
+    return true
+  })
+  check(opened, 'workspace chip 可点击')
+  await page.waitForTimeout(800)
+  check(await page.getByText(/Sync from ticket|从工单号同步/).count() > 0, '菜单含「从工单号同步」')
+
+  // 2) 打开对话框
+  await page.getByText(/Sync from ticket|从工单号同步/).first().click()
+  await page.waitForTimeout(600)
+  check(await page.getByText('从工单号同步日志').count() > 0, '对话框标题出现')
+
+  // 3) 本地格式校验与服务端同规则：非法禁用、合法启用
+  const dialog = page.getByRole('dialog')
+  const input = dialog.locator('input').first()
+  const confirm = dialog.getByRole('button', { name: /确定/ })
+  check(await confirm.count() === 1, '对话框内只有一个「确定」按钮')
+  await input.fill('Q123')
+  await page.waitForTimeout(300)
+  check(await confirm.isDisabled().catch(() => false), '非法工单号禁用「确定」')
+  await input.fill('Q2026012500018')
+  await page.waitForTimeout(300)
+  check(await confirm.isEnabled().catch(() => false), '合法工单号启用「确定」')
+
+  await page.screenshot({ path: '/tmp/ticket-ui.png' })
+  console.log('截图：/tmp/ticket-ui.png')
+} finally {
+  await browser.close()
+}
+
+if (failures.length > 0) {
+  console.error(`UI 冒烟失败 ${String(failures.length)} 项`)
+  process.exit(1)
+}
+console.log('UI 冒烟通过')
