diff --git a/packages/api/ticket-sync/src/extractor.ts b/packages/api/ticket-sync/src/extractor.ts
new file mode 100644
index 00000000..f3123b4f
--- /dev/null
+++ b/packages/api/ticket-sync/src/extractor.ts
@@ -0,0 +1,550 @@
+/**
+ * 递归解压：把工单包解到叶子，让日志成为 workspace 里的普通文件。
+ *
+ * 四条不可让步的约束，每条都来自实测：
+ * 1. **逐条目循环**，不能用 `unzip -p '*.tgz'` 通配 —— 多个归档串接进同一管道时
+ *    tar 在第一个归档的 EOF 处退出，后者被静默丢弃（989MB 样本实测：通配只得到
+ *    0.62GB，逐条目才是 1.44GB）。
+ * 2. **中间层不落盘**：`unzip -p <zip> <entry> | tar -x` 让峰值从
+ *    `zip + tgz + 内容` 降为 `zip + 内容`，20GiB 级工单靠这一条才谈得上可行。
+ * 3. **解压前拒绝链接条目**：tar 会原样创建 symlink，`a -> /etc` 之后再写
+ *    `a/x` 就落到 workspace 之外。事后清理存在竞态，必须在解压前从条目表拒绝。
+ * 4. **事中水位**：tgz 展开比在 1.5x~20x 之间跳变，事前算不出总量；解压期间
+ *    每 500ms 采样分区剩余，低于红线立即杀进程并清理。
+ *
+ * 所有外部依赖（子进程、剩余空间、目录测量）都收敛到 `ExtractDeps`：
+ * 测试可以注入「剩余空间只有 1 字节」或「命令立即失败」，不必真的把盘写满，
+ * 也不必为了验证水位等几十秒。
+ * @module @deepseek-ai/dsh-api-ticket-sync/extractor
+ */
+
+import { execFile, spawn } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import { mkdir, readdir, rename, rm, stat, statfs, writeFile } from 'node:fs/promises'
+import { basename, dirname, join } from 'node:path'
+
+/** 可展开的压缩包后缀；其余类型原样保留（rar/7z/zst 不在能力内）。 */
+const ARCHIVE_SUFFIXES = ['.zip', '.tgz', '.tar.gz', '.tar'] as const
+
+/** 完成标记文件名：workspace 只有在它存在时才算「完整产物」。 */
+export const READY_MARKER = '.ready'
+
+/** 解压过程中的硬限制。 */
+export interface ExtractLimits {
+  /** 单工单解压总量上限（字节）。 */
+  maxExtractBytes: number
+  /** 解压过程中必须保留的分区剩余空间（字节）。 */
+  minFreeBytes: number
+  /** 解出的文件数上限。 */
+  maxFiles: number
+  /** 递归层数上限；已解出的压缩包再展开一层计一层。 */
+  maxDepth: number
+  /** 水位采样间隔（毫秒），默认 500。 */
+  sampleIntervalMs?: number
+}
+
+/** 一次递归解压的结果。 */
+export interface ExtractResult {
+  /** 最终落盘字节数。 */
+  bytes: number
+  /** 最终文件数。 */
+  files: number
+  /** 实际展开到的最大层数。 */
+  depth: number
+  /** 因含链接条目被拒绝的归档数（正常样本为 0）。 */
+  rejectedLinks: number
+}
+
+/** 解压领域的失败，携带可映射到 Remote 错误码的分类。 */
+export class ExtractError extends Error {
+  /**
+   * @param code - 失败分类，直接被控制器映射成 `ticket/*`。
+   * @param message - 面向操作者的说明。
+   */
+  constructor(readonly code: 'archive-corrupt' | 'bad-password' | 'space-exceeded' | 'too-many-files' | 'extract-failed' | 'cancelled', message: string) {
+    super(message)
+    this.name = 'ExtractError'
+  }
+}
+
+/** `execFile` 的结果；失败不抛，由调用方按退出码判定（解压命令的非零退出是数据问题，不是崩溃）。 */
+export interface CommandResult {
+  code: number
+  stdout: string
+  stderr: string
+}
+
+/** 可替换的运行时依赖：测试用它构造「空间不足 / 命令失败 / 大目录」等场景。 */
+export interface ExtractDeps {
+  /** 执行一个外部命令（有界输出，abort 时杀进程）。 */
+  run: (command: string, args: readonly string[], signal: AbortSignal) => Promise<CommandResult>
+  /** 分区剩余字节数。 */
+  freeBytes: (path: string) => Promise<number>
+  /** 目录树的字节数与文件数。 */
+  measure: (root: string) => Promise<{ bytes: number; files: number }>
+  /** 启动子进程（流式管道用）。 */
+  spawn: typeof spawn
+}
+
+/** 同步执行一个外部命令，stdout/stderr 有界收集，abort 时杀进程。 */
+function runCommand(command: string, args: readonly string[], signal: AbortSignal): Promise<CommandResult> {
+  return new Promise((resolveResult, reject) => {
+    const child = execFile(command, [...args], {
+      maxBuffer: 8 * 1024 * 1024,
+      signal,
+    }, (error, stdout, stderr) => {
+      if (error !== null && typeof error === 'object' && 'code' in error && typeof error.code === 'string') {
+        // 被 abort 杀掉：交给调用方按取消/水位分类。
+        reject(signal.reason instanceof ExtractError
+          ? signal.reason
+          : new ExtractError('cancelled', `命令被中断：${command} ${error.code}`))
+        return
+      }
+      const code = error === null ? 0 : (typeof error.code === 'number' ? error.code : 1)
+      resolveResult({ code, stdout, stderr })
+    })
+    child.on('error', (error: NodeJS.ErrnoException) => {
+      // 命令不存在是部署缺陷（镜像缺 unzip/tar），必须与数据问题区分开。
+      if (error.code === 'ENOENT') {
+        reject(new ExtractError('extract-failed', `容器内缺少命令：${command}`))
+        return
+      }
+      reject(error)
+    })
+  })
+}
+
+/** 分区剩余字节数（容量预检与事中水位共用）。 */
+export async function freeBytes(path: string): Promise<number> {
+  try {
+    const stats = await statfs(path)
+    return Number(stats.bavail) * Number(stats.bsize)
+  } catch {
+    return 0
+  }
+}
+
+/** 目录树的字节数与文件数（递归 lstat，不经 shell，避免 busybox 方言与 maxBuffer 限制）。 */
+async function measureTree(root: string): Promise<{ bytes: number; files: number }> {
+  let bytes = 0
+  let files = 0
+  const walk = async (directory: string): Promise<void> => {
+    const entries = await readdir(directory, { withFileTypes: true }).catch(() => [])
+    for (const entry of entries) {
+      const path = join(directory, entry.name)
+      if (entry.isDirectory()) {
+        await walk(path)
+        continue
+      }
+      const info = await stat(path).catch(() => undefined)
+      if (info === undefined) continue
+      bytes += info.size
+      files += 1
+    }
+  }
+  await walk(root)
+  return { bytes, files }
+}
+
+/** 默认依赖：真实文件系统与真实子进程。 */
+const DEFAULT_DEPS: ExtractDeps = {
+  run: runCommand,
+  freeBytes,
+  measure: measureTree,
+  spawn,
+}
+
+/** 条目名是否安全：不得绝对路径、不得含 `..` 段。 */
+function isSafeEntry(name: string): boolean {
+  if (name.startsWith('/') || /^[A-Za-z]:/.test(name)) return false
+  return !name.split(/[/\\]/).includes('..')
+}
+
+/** 该名称是否属于本模块能展开的压缩包。 */
+function isArchive(name: string): boolean {
+  const lower = name.toLowerCase()
+  return ARCHIVE_SUFFIXES.some(suffix => lower.endsWith(suffix))
+}
+
+/** 去掉压缩后缀后的目录名。 */
+function stripArchiveSuffix(name: string): string {
+  const stripped = name.replace(/\.(tar\.gz|tgz|zip|tar)$/i, '')
+  // 后缀被完全吃掉时（如 `.zip` 本身）回落到 `<名字>-extracted`，避免与父目录同名。
+  return stripped === '' ? `${name}-extracted` : stripped
+}
+
+/** 压缩包解压后的目标目录：同级、去掉压缩后缀。 */
+function targetDirFor(archivePath: string): string {
+  return join(dirname(archivePath), stripArchiveSuffix(basename(archivePath)))
+}
+
+/** 列出 zip 条目名（只读中央目录，不需要密码）。 */
+async function listZipEntries(zipPath: string, signal: AbortSignal, deps: ExtractDeps): Promise<string[]> {
+  const result = await deps.run('unzip', ['-Z1', zipPath], signal)
+  if (result.code !== 0) throw new ExtractError('archive-corrupt', `无法读取压缩包目录：${result.stderr.trim()}`)
+  return result.stdout.split('\n').filter(line => line !== '')
+}
+
+/**
+ * 流式列出 tar 条目并校验，不缓冲全量输出。
+ *
+ * 必须先 list 再解：类型字符 `l`/`h` 是关键 —— 链接条目会让解压写到
+ * workspace 之外，而事后清理存在竞态（写完才删）。行数上界同时充当
+ * 文件数护栏，避免在解压前就把几十万条目录读进内存。
+ * @param feed - 产出 tar 字节流的命令。
+ */
+function inspectTarStream(
+  deps: ExtractDeps,
+  feed: () => ReturnType<typeof spawn>,
+  signal: AbortSignal,
+  maxFiles: number,
+): Promise<{ entries: number }> {
+  return new Promise((resolveResult, reject) => {
+    const producer = feed()
+    const lister = deps.spawn('tar', ['-tvzf', '-'], { stdio: ['pipe', 'pipe', 'pipe'] })
+    let pending = ''
+    let entries = 0
+    let stderr = ''
+    const collect = (chunk: Buffer): void => {
+      stderr = `${stderr}${chunk.toString()}`.slice(-4096)
+    }
+    producer.stderr?.on('data', collect)
+    lister.stderr.on('data', collect)
+    const abort = (): void => {
+      producer.kill('SIGKILL')
+      lister.kill('SIGKILL')
+    }
+    signal.addEventListener('abort', abort, { once: true })
+    // feed() 显式声明了 stdout 为 pipe，但子进程类型仍可能推导为 null。
+    producer.stdout?.pipe(lister.stdin)
+    producer.on('close', () => { lister.stdin.end() })
+
+    lister.stdout.on('data', (chunk: Buffer) => {
+      pending += chunk.toString()
+      const lines = pending.split('\n')
+      pending = lines.pop() ?? ''
+      for (const line of lines) {
+        if (line === '') continue
+        entries += 1
+        if (entries > maxFiles) {
+          abort()
+          reject(new ExtractError('too-many-files', `归档条目数超过上限 ${String(maxFiles)}`))
+          return
+        }
+        if (line.startsWith('l') || line.startsWith('h')) {
+          abort()
+          reject(new ExtractError('extract-failed', '归档含符号/硬链接条目，已拒绝解压'))
+          return
+        }
+        const columns = line.trim().split(/\s+/)
+        const name = columns.slice(8).join(' ').split(' -> ')[0] ?? ''
+        if (!isSafeEntry(name)) {
+          abort()
+          reject(new ExtractError('extract-failed', `归档条目越界：${name}`))
+          return
+        }
+      }
+    })
+    lister.on('close', (code) => {
+      signal.removeEventListener('abort', abort)
+      producer.kill('SIGKILL')
+      if (code !== 0 && !signal.aborted) {
+        reject(new ExtractError('archive-corrupt', `无法读取归档目录：${stderr.trim()}`))
+        return
+      }
+      resolveResult({ entries })
+    })
+    lister.on('error', (error: NodeJS.ErrnoException) => {
+      reject(new ExtractError('extract-failed',
+        error.code === 'ENOENT' ? '容器内缺少命令：tar' : error.message))
+    })
+  })
+}
+
+/** 把 `unzip -p <zip> <entry>` 的 stdout 直接喂给 `tar -x -C <target>`。 */
+function pipeToTar(
+  deps: ExtractDeps,
+  zipPath: string,
+  entry: string,
+  password: string,
+  target: string,
+  signal: AbortSignal,
+): Promise<CommandResult> {
+  return new Promise((resolveResult, reject) => {
+    const source = deps.spawn('unzip', ['-P', password, '-p', zipPath, entry], { stdio: ['ignore', 'pipe', 'pipe'] })
+    const sink = deps.spawn('tar', ['-xzf', '-', '-C', target], { stdio: ['pipe', 'ignore', 'pipe'] })
+    let stderr = ''
+    const collect = (chunk: Buffer): void => {
+      stderr = `${stderr}${chunk.toString()}`.slice(-4096)
+    }
+    source.stderr.on('data', collect)
+    sink.stderr.on('data', collect)
+    const abort = (): void => {
+      source.kill('SIGKILL')
+      sink.kill('SIGKILL')
+    }
+    signal.addEventListener('abort', abort, { once: true })
+    source.stdout.pipe(sink.stdin)
+    source.on('close', () => { sink.stdin.end() })
+    const failures: string[] = []
+    source.on('error', (error: NodeJS.ErrnoException) => {
+      failures.push(error.code === 'ENOENT' ? '容器内缺少命令：unzip' : error.message)
+    })
+    sink.on('error', (error: NodeJS.ErrnoException) => {
+      failures.push(error.code === 'ENOENT' ? '容器内缺少命令：tar' : error.message)
+    })
+    sink.on('close', (code) => {
+      signal.removeEventListener('abort', abort)
+      source.kill('SIGKILL')
+      if (failures.length > 0) {
+        reject(new ExtractError('extract-failed', failures.join('；')))
+        return
+      }
+      resolveResult({ code: code ?? 1, stdout: '', stderr })
+    })
+  })
+}
+
+/** 解一个磁盘上的 zip 到同名目录（条目已前置校验；`-o` 保证重试幂等）。 */
+async function extractZip(deps: ExtractDeps, zipPath: string, password: string, signal: AbortSignal): Promise<string> {
+  const entries = await listZipEntries(zipPath, signal, deps)
+  const unsafe = entries.find(name => !isSafeEntry(name))
+  if (unsafe !== undefined) throw new ExtractError('extract-failed', `压缩包条目越界：${unsafe}`)
+  const target = targetDirFor(zipPath)
+  await mkdir(target, { recursive: true })
+  const result = await deps.run('unzip', ['-P', password, '-o', '-qq', zipPath, '-d', target], signal)
+  if (result.code !== 0) {
+    const message = result.stderr.toLowerCase()
+    if (message.includes('password') || message.includes('incorrect')) {
+      throw new ExtractError('bad-password', '解压时密码被拒绝')
+    }
+    throw new ExtractError('extract-failed', `解压失败：${result.stderr.trim()}`)
+  }
+  return target
+}
+
+/** 解一个磁盘上的 tar 类归档到同名目录，成功后删除归档本体。 */
+async function extractTar(deps: ExtractDeps, tarPath: string, limits: ExtractLimits, signal: AbortSignal): Promise<string> {
+  await inspectTarStream(deps, () => deps.spawn('cat', [tarPath], { stdio: ['ignore', 'pipe', 'ignore'] }), signal, limits.maxFiles)
+  const target = targetDirFor(tarPath)
+  await mkdir(target, { recursive: true })
+  const result = await deps.run('tar', ['-xzf', tarPath, '-C', target], signal)
+  if (result.code !== 0) throw new ExtractError('extract-failed', `归档解压失败：${result.stderr.trim()}`)
+  // 已展开的归档本体不再保留：验收要求「无残留 .tgz」，且它已无复用价值。
+  await rm(tarPath, { force: true })
+  return target
+}
+
+/** 递归扫描 `root` 下尚未展开的压缩包。 */
+async function findArchives(root: string): Promise<string[]> {
+  const found: string[] = []
+  const walk = async (dir: string): Promise<void> => {
+    const entries = await readdir(dir, { withFileTypes: true }).catch(() => [])
+    for (const entry of entries) {
+      const path = join(dir, entry.name)
+      if (entry.isDirectory()) {
+        await walk(path)
+      } else if (entry.isFile() && isArchive(entry.name)) {
+        found.push(path)
+      }
+    }
+  }
+  await walk(root)
+  return found
+}
+
+/**
+ * 在解压过程中执行水位采样：越线即中止 `work` 传入的信号。
+ *
+ * 单次采样间隔 500ms，配合 5GB/s 的本地解压速度也只会穿透约 2.5GB，
+ * 远小于 `minFreeBytes` 的 60GiB 余量。测试注入 `freeBytes` 即可在
+ * 毫秒内验证这条路径，不需要真的造一个快满的盘。
+ */
+async function withWaterGuard<T>(
+  deps: ExtractDeps,
+  root: string,
+  limits: ExtractLimits,
+  signal: AbortSignal,
+  work: (guarded: AbortSignal) => Promise<T>,
+): Promise<T> {
+  const controller = new AbortController()
+  const forward = (): void => { controller.abort(signal.reason) }
+  signal.addEventListener('abort', forward, { once: true })
+  const timer = setInterval(() => {
+    void deps.freeBytes(root).then((free) => {
+      if (free < limits.minFreeBytes && !controller.signal.aborted) {
+        controller.abort(new ExtractError('space-exceeded', `分区剩余 ${String(free)} 低于红线 ${String(limits.minFreeBytes)}`))
+      }
+    })
+  }, limits.sampleIntervalMs ?? 500)
+  timer.unref?.()
+  try {
+    return await work(controller.signal)
+  } finally {
+    clearInterval(timer)
+    signal.removeEventListener('abort', forward)
+  }
+}
+
+/**
+ * 把工单包解到叶子。
+ *
+ * 流程：zip 的普通文件直接展开 → 每个归档条目**流式**管道解到同名目录 →
+ * 后续层同样先 list 校验再解，成功后删除归档本体 → 直到无候选或触达 `maxDepth`。
+ * 全程有水位守卫，越界立即中止（调用方负责清理 root）。
+ * @param zipPath - 已落地的工单 zip。
+ * @param root - 解压目标目录（调用方提供的 `extract.tmp-*`）。
+ * @param password - zip 密码；递归层内的 tar 不再需要。
+ * @param limits - 硬限制。
+ * @param signal - 取消信号，直达每个子进程。
+ * @param onLayer - 每解完一个归档回调（用于进度帧）。
+ * @param overrides - 测试注入点（默认真实文件系统与子进程）。
+ * @returns 体积、文件数、层数与拒绝的链接数。
+ */
+export async function extractToLeaf(
+  zipPath: string,
+  root: string,
+  password: string,
+  limits: ExtractLimits,
+  signal: AbortSignal,
+  onLayer: (info: { depth: number; bytes: number; files: number; archive: string }) => void,
+  overrides: Partial<ExtractDeps> = {},
+): Promise<ExtractResult> {
+  const deps: ExtractDeps = { ...DEFAULT_DEPS, ...overrides }
+  await mkdir(root, { recursive: true })
+  const entries = await listZipEntries(zipPath, signal, deps)
+  const unsafe = entries.find(name => !isSafeEntry(name))
+  if (unsafe !== undefined) throw new ExtractError('extract-failed', `压缩包条目越界：${unsafe}`)
+
+  const archives = entries.filter(name => isArchive(name))
+  const plain = entries.filter(name => !isArchive(name))
+
+  // 第一层：普通文件一次解出；归档条目走流式管道，中间 tgz 不落盘。
+  if (plain.length > 0) {
+    const first = await deps.run('unzip', ['-P', password, '-o', '-qq', zipPath, '-d', root, ...plain], signal)
+    if (first.code !== 0) {
+      const message = first.stderr.toLowerCase()
+      if (message.includes('password') || message.includes('incorrect')) {
+        throw new ExtractError('bad-password', '解压时密码被拒绝')
+      }
+      throw new ExtractError('extract-failed', `解压失败：${first.stderr.trim()}`)
+    }
+  }
+
+  let rejectedLinks = 0
+  let depth = 1
+  const record = async (archive: string, layer: number): Promise<void> => {
+    const after = await deps.measure(root)
+    onLayer({ depth: layer, bytes: after.bytes, files: after.files, archive })
+    if (after.bytes > limits.maxExtractBytes) {
+      throw new ExtractError('space-exceeded', `解压总量 ${String(after.bytes)} 超过上限 ${String(limits.maxExtractBytes)}`)
+    }
+    if (after.files > limits.maxFiles) {
+      throw new ExtractError('too-many-files', `解出文件数 ${String(after.files)} 超过上限 ${String(limits.maxFiles)}`)
+    }
+    const free = await deps.freeBytes(root)
+    if (free < limits.minFreeBytes) {
+      throw new ExtractError('space-exceeded', `分区剩余 ${String(free)} 低于红线 ${String(limits.minFreeBytes)}`)
+    }
+  }
+
+  for (const entry of archives) {
+    if (depth >= limits.maxDepth) break
+    if (entry.toLowerCase().endsWith('.zip')) {
+      // 内层 zip 需要随机访问中央目录：先落地成文件，交给下一轮递归（解完即删）。
+      await deps.run('unzip', ['-P', password, '-o', '-qq', zipPath, entry, '-d', root], signal)
+      continue
+    }
+    const target = join(root, stripArchiveSuffix(basename(entry)))
+    await mkdir(target, { recursive: true })
+    try {
+      await withWaterGuard(deps, root, limits, signal, async (guarded) => {
+        await inspectTarStream(
+          deps,
+          () => deps.spawn('unzip', ['-P', password, '-p', zipPath, entry], { stdio: ['ignore', 'pipe', 'pipe'] }),
+          guarded,
+          limits.maxFiles,
+        )
+        const piped = await pipeToTar(deps, zipPath, entry, password, target, guarded)
+        if (piped.code !== 0) throw new ExtractError('extract-failed', `解压失败：${piped.stderr.trim()}`)
+      })
+      await record(entry, depth + 1)
+    } catch (error) {
+      if (error instanceof ExtractError && error.message.includes('链接')) rejectedLinks += 1
+      throw error
+    }
+  }
+  depth = Math.min(depth + 1, limits.maxDepth)
+
+  // 后续层：磁盘上的归档逐层展开，成功后删除本体。
+  for (;;) {
+    const found = await findArchives(root)
+    if (found.length === 0) break
+    if (depth >= limits.maxDepth) break
+    for (const archive of found) {
+      await withWaterGuard(deps, root, limits, signal, async (guarded) => {
+        if (archive.toLowerCase().endsWith('.zip')) {
+          await extractZip(deps, archive, password, guarded)
+          await rm(archive, { force: true })
+        } else {
+          await extractTar(deps, archive, limits, guarded)
+        }
+      })
+      await record(archive, depth + 1)
+    }
+    depth += 1
+  }
+
+  const final = await deps.measure(root)
+  return { bytes: final.bytes, files: final.files, depth, rejectedLinks }
+}
+
+/**
+ * 原子就位：`extract.tmp-*` → `extract`，并写入 `.ready` 完成标记。
+ *
+ * 采用「新目录先行 + 旧目录后删」两段式，避免 `rm -rf target` 造成的
+ * 目标短暂不存在的窗口（Agent 可能正在读）。
+ */
+export async function promote(root: string, target: string, deps: Pick<ExtractDeps, 'measure'> = DEFAULT_DEPS): Promise<void> {
+  const retired = `${target}.old-${String(Date.now())}`
+  const hadTarget = existsSync(target)
+  if (hadTarget) await rename(target, retired)
+  try {
+    await rename(root, target)
+  } catch (error) {
+    if (hadTarget) await rename(retired, target).catch(() => undefined)
+    throw error
+  }
+  if (hadTarget) await rm(retired, { recursive: true, force: true })
+  const measured = await deps.measure(target)
+  await writeFile(join(target, READY_MARKER), JSON.stringify({
+    bytes: measured.bytes,
+    files: measured.files,
+    at: new Date().toISOString(),
+  }), 'utf8')
+}
+
+/** 目录是否已是完整产物：存在 `.ready` 标记（老版本没有标记时退回目录判断）。 */
+export async function isReady(target: string): Promise<boolean> {
+  if (existsSync(join(target, READY_MARKER))) return true
+  return stat(target).then(info => info.isDirectory(), () => false)
+}
+
+/** 校验密码：解压最小**文件**条目（目录条目无法验证密钥，必须跳过）。 */
+export async function verifyPassword(
+  zipPath: string,
+  password: string,
+  signal: AbortSignal,
+  deps: Pick<ExtractDeps, 'run'> = DEFAULT_DEPS,
+): Promise<boolean> {
+  const entries = await listZipEntries(zipPath, signal, { ...DEFAULT_DEPS, ...deps })
+  if (entries.length === 0) throw new ExtractError('archive-corrupt', '压缩包内没有任何条目')
+  const candidates = entries.filter(name => !name.endsWith('/'))
+  if (candidates.length === 0) throw new ExtractError('archive-corrupt', '压缩包内没有任何文件条目')
+  const probe = candidates.reduce((shortest, name) => (name.length < shortest.length ? name : shortest), candidates[0] ?? '')
+  const result = await deps.run('unzip', ['-P', password, '-p', zipPath, probe], signal)
+  if (result.code === 0) return true
+  const message = result.stderr.toLowerCase()
+  if (message.includes('password') || message.includes('incorrect')) return false
+  throw new ExtractError('archive-corrupt', `压缩包无法解压：${result.stderr.trim()}`)
+}
