new file mode 100644
index 00000000..a619887f
--- /dev/null
+++ b/packages/api/ticket-sync/src/syncer.ts
@@ -0,0 +1,230 @@
+/**
+ * 传输适配器：把"怎么把工单包搬到本地"隔离在一个两方法接口之后。
+ *
+ * 队列、状态机与界面都不关心传输形态；换实现只改这里。三个实现分别对应
+ * 三条已知路径：0.2 的只读 HTTP（主线、镜像零改动）、本地预置文件（测试与
+ * 无依赖联调）、ssh 拉取（HTTP 端口不被允许时的退路）。
+ * @module @deepseek-ai/dsh-api-ticket-sync/syncer
+ */
+
+import { spawn } from 'node:child_process'
+import { createWriteStream } from 'node:fs'
+import { copyFile, mkdir, rename, rm, stat as statFile } from 'node:fs/promises'
+import { dirname } from 'node:path'
+import { Readable, Transform } from 'node:stream'
+import { pipeline } from 'node:stream/promises'
+
+/** 传输进度回调；`total` 未知时只报已传字节。 */
+export type TransferProgress = (bytes: number, total?: number) => void
+
+/** 一次传输的结果。`stderrTail` 用于失败排障，不参与判定。 */
+export interface TransferResult {
+  size: number
+  stderrTail: string
+}
+
+/** 传输适配器契约：先能探大小（容量预检的前提），再能落地。 */
+export interface TicketSyncer {
+  /**
+   * 远端是否提供该工单及其字节数；不存在返回 null。
+   * 容量预检必须在传输前拿到大小，否则"超限"只能在传完之后才发现。
+   */
+  stat(ticketId: string): Promise<{ size: number } | null>
+  /**
+   * 把工单包落到 `destPath`（绝对路径）。实现必须自行保证：
+   * 断点续传走 `.part` 临时文件，成功后原子 `rename` —— 半成品不能出现在最终路径。
+   */
+  fetch(ticketId: string, destPath: string, signal: AbortSignal, onProgress: TransferProgress): Promise<TransferResult>
+}
+
+/** 保留的 stderr 尾部字节数：够排障，又不会被巨量输出撑爆内存。 */
+const STDERR_TAIL_BYTES = 4096
+
+/** 追加一段输出到有界尾部缓冲。 */
+function appendTail(current: string, chunk: string): string {
+  const merged = current + chunk
+  return merged.length > STDERR_TAIL_BYTES ? merged.slice(-STDERR_TAIL_BYTES) : merged
+}
+
+/**
+ * 只读 HTTP 源（主线）。
+ *
+ * 选它的理由是四条硬需求同时被满足：`HEAD` 拿 Content-Length（容量预检）、
+ * `Range` 断点续传（大包中断必需）、无凭据（私钥不进 Pod）、镜像零依赖。
+ */
+export class HttpSyncer implements TicketSyncer {
+  /**
+   * @param baseUrl - 远端只读根，形如 `http://192.168.0.2:8081`（不带尾斜杠）。
+   * @param fetchImpl - 可注入的 fetch，便于单测；默认用进程内置实现。
+   */
+  constructor(
+    private readonly baseUrl: string,
+    private readonly fetchImpl: typeof fetch = fetch,
+  ) {}
+
+  /** 工单包的远端 URL；路径由已校验的工单号拼成，不含用户可控片段。 */
+  private urlOf(ticketId: string): string {
+    return `${this.baseUrl.replace(/\/+$/, '')}/${ticketId}/${ticketId}.zip`
+  }
+
+  /** @inheritdoc */
+  async stat(ticketId: string): Promise<{ size: number } | null> {
+    const response = await this.fetchImpl(this.urlOf(ticketId), { method: 'HEAD' })
+    if (response.status === 404) return null
+    if (!response.ok) {
+      throw new Error(`远端探测失败：HTTP ${response.status}`)
+    }
+    const length = response.headers.get('content-length')
+    if (length === null) return { size: 0 }
+    return { size: Number.parseInt(length, 10) }
+  }
+
+  /** @inheritdoc */
+  async fetch(ticketId: string, destPath: string, signal: AbortSignal, onProgress: TransferProgress): Promise<TransferResult> {
+    await mkdir(dirname(destPath), { recursive: true })
+    const partPath = `${destPath}.part`
+    // 已下载的部分优先续传；size 为 0 表示还没开始。
+    const offset = await statFile(partPath).then(file => file.size, () => 0)
+    const headers: Record<string, string> = offset > 0 ? { Range: `bytes=${offset}-` } : {}
+    const response = await this.fetchImpl(this.urlOf(ticketId), { headers, signal })
+    if (response.status === 416) {
+      // 416 只说明「Range 无法满足」，不等于「.part 已完整」：远端文件可能
+      // 已被替换，旧 .part 就是一份损坏的前缀。必须比对远端长度后才能就位。
+      const remote = await this.stat(ticketId)
+      if (remote !== null && remote.size === offset) {
+        await rename(partPath, destPath)
+        return { size: offset, stderrTail: '' }
+      }
+      await rm(partPath, { force: true })
+      return this.fetch(ticketId, destPath, signal, onProgress)
+    }
+    if (response.status === 404) throw new Error('远端不存在该工单包')
+    if (!response.ok) throw new Error(`远端拒绝传输：HTTP ${response.status}`)
+    if (response.body === null) throw new Error('远端响应没有 body')
+
+    const totalHeader = response.headers.get('content-length')
+    const total = totalHeader === null ? undefined : Number.parseInt(totalHeader, 10) + offset
+    let received = offset
+    const counter = new Transform({
+      transform(chunk: Buffer, _encoding, callback) {
+        received += chunk.byteLength
+        onProgress(received, total)
+        callback(null, chunk)
+      },
+    })
+    const sink = createWriteStream(partPath, { flags: offset > 0 ? 'a' : 'w' })
+    // Node 的类型里 fetch body 是 web ReadableStream，需显式转换。
+    await pipeline(Readable.fromWeb(response.body as Parameters<typeof Readable.fromWeb>[0]), counter, sink)
+    await rename(partPath, destPath)
+    return { size: received, stderrTail: '' }
+  }
+}
+
+/**
+ * 本地预置文件源（测试与无依赖联调用）。
+ *
+ * 它让整条链路（队列 → 解压 → 就位 → 登记 workspace）可以在没有 0.2、
+ * 没有 HTTP 服务的情况下被端到端验证，也是 Pod 重建后"重解不重传"的兜底。
+ */
+export class LocalFileSyncer implements TicketSyncer {
+  /** @param sourceDir - 预置工单包目录，其下为 `<id>/<id>.zip`。 */
+  constructor(private readonly sourceDir: string) {}
+
+  /** @inheritdoc */
+  async stat(ticketId: string): Promise<{ size: number } | null> {
+    const path = `${this.sourceDir}/${ticketId}/${ticketId}.zip`
+    return statFile(path).then(file => ({ size: file.size }), () => null)
+  }
+
+  /** @inheritdoc */
+  async fetch(ticketId: string, destPath: string, _signal: AbortSignal, onProgress: TransferProgress): Promise<TransferResult> {
+    const source = `${this.sourceDir}/${ticketId}/${ticketId}.zip`
+    await mkdir(dirname(destPath), { recursive: true })
+    await copyFile(source, destPath)
+    const size = await statFile(destPath).then(file => file.size, () => 0)
+    onProgress(size, size)
+    return { size, stderrTail: '' }
+  }
+}
+
+/**
+ * ssh 拉取源（退路）。
+ *
+ * 只在"0.2 不允许新开 HTTP 端口"时启用。用 `ssh cat` 而不是 rsync：容器里
+ * 只需 openssh-client，少一个依赖；断点续传由本地 `.part` 的字节偏移做不到
+ * （远端 cat 无法定位），因此该实现**不支持续传**，中断即从头再来 —— 这是
+ * 退路的能力缺口，必须在文档里写明。
+ */
+export class SshSyncer implements TicketSyncer {
+  /**
+   * @param options - 远端主机、端口、用户与远端根目录。
+   */
+  constructor(private readonly options: {
+    host: string
+    port: number
+    user: string
+    remoteRoot: string
+    /** 私钥路径；缺省用 ssh-agent 或默认密钥。 */
+    identityFile?: string
+  }) {}
+
+  /** 远端文件路径；工单号已由调用方校验。 */
+  private remotePathOf(ticketId: string): string {
+    return `${this.options.remoteRoot.replace(/\/+$/, '')}/${ticketId}/${ticketId}.zip`
+  }
+
+  /** ssh 的公共参数（BatchMode 保证不会卡在交互提示上）。 */
+  private sshArgs(command: string[]): string[] {
+    const args = ['-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes', '-p', String(this.options.port)]
+    if (this.options.identityFile !== undefined) args.push('-i', this.options.identityFile)
+    args.push(`${this.options.user}@${this.options.host}`, ...command)
+    return args
+  }
+
+  /** @inheritdoc */
+  async stat(ticketId: string): Promise<{ size: number } | null> {
+    const args = this.sshArgs(['stat', '-c', '%s', this.remotePathOf(ticketId)])
+    const child = spawn('ssh', args, { stdio: ['ignore', 'pipe', 'pipe'] })
+    let out = ''
+    let err = ''
+    child.stdout.on('data', (chunk: Buffer) => { out += chunk.toString() })
+    child.stderr.on('data', (chunk: Buffer) => { err = appendTail(err, chunk.toString()) })
+    const code = await new Promise<number | null>(resolve => child.on('close', resolve))
+    if (code !== 0) {
+      // stat 失败就是"没有这个文件"或"连不上"，两者都按不存在处理，由 fetch 再报细节。
+      if (err.includes('No such file')) return null
+      return null
+    }
+    const size = Number.parseInt(out.trim(), 10)
+    return Number.isNaN(size) ? null : { size }
+  }
+
+  /** @inheritdoc */
+  async fetch(ticketId: string, destPath: string, signal: AbortSignal, onProgress: TransferProgress): Promise<TransferResult> {
+    await mkdir(dirname(destPath), { recursive: true })
+    const partPath = `${destPath}.part`
+    const args = this.sshArgs(['cat', this.remotePathOf(ticketId)])
+    const child = spawn('ssh', args, { stdio: ['ignore', 'pipe', 'pipe'] })
+    let stderrTail = ''
+    let received = 0
+    child.stderr.on('data', (chunk: Buffer) => { stderrTail = appendTail(stderrTail, chunk.toString()) })
+    const counter = new Transform({
+      transform(chunk: Buffer, _encoding, callback) {
+        received += chunk.byteLength
+        onProgress(received)
+        callback(null, chunk)
+      },
+    })
+    const abort = (): void => { child.kill('SIGTERM') }
+    signal.addEventListener('abort', abort, { once: true })
+    try {
+      await pipeline(child.stdout, counter, createWriteStream(partPath))
+      const code = await new Promise<number | null>(resolve => child.on('close', resolve))
+      if (code !== 0) throw new Error(`ssh 退出码 ${String(code)}：${stderrTail}`)
+      await rename(partPath, destPath)
+      return { size: received, stderrTail }
+    } finally {
+      signal.removeEventListener('abort', abort)
+    }
+  }
+}
diff --git a/packages/api/ticket-sync/src/types.ts b/packages/api/ticket-sync/src/types.ts
new file mode 100644
index 00000000..8011652c
--- /dev/null
+++ b/packages/api/ticket-sync/src/types.ts
@@ -0,0 +1,121 @@
+/**
+ * 工单同步的协议面：Remote 请求/响应、进度帧、阶段与错误码。
+ *
+ * 这里只放类型与唯一常量，不放运行时逻辑 —— 客户端编译面会直接引用它，
+ * 任何 `node:` 导入都会把宿主实现泄漏进浏览器包。
+ * @module @deepseek-ai/dsh-api-ticket-sync/types
+ */
+
+/** 一次同步任务所处的阶段。终态是 `ready` / `failed` / `cancelled`。 */
+export type TicketPhase =
+  | 'queued'
+  | 'verifying'
+  | 'syncing'
+  | 'extracting'
+  | 'ready'
+  | 'failed'
+  | 'cancelled'
+
+/**
+ * 失败词汇表（闭集）。客户端只按 code 判别，不解析 message；
+ * 新增分类必须同时更新这里与控制器里的极射表。
+ */
+export type TicketErrorCode =
+  /** 工单号不匹配 `^Q\d{13}$`，或拼出的路径越出工单根。 */
+  | 'ticket/invalid-id'
+  /** 远端没有该工单目录或压缩包。 */
+  | 'ticket/not-found'
+  /** 远端压缩包超过 `maxTicketBytes`，传输前即拒绝。 */
+  | 'ticket/too-large'
+  /** 本地剩余空间不足以容纳"压缩包 + 按上界预估的展开量"。 */
+  | 'ticket/insufficient-storage'
+  /** 未提供密码，或密码预校验失败。 */
+  | 'ticket/bad-password'
+  /** 压缩包结构损坏（含 1 字节占位包）。 */
+  | 'ticket/archive-corrupt'
+  /** 解压过程中触达 `maxExtractBytes` 或剩余空间低于 `minFreeBytes`。 */
+  | 'ticket/space-exceeded'
+  /** 解出的文件数超过 `maxFiles`，防止打穿 inode 与索引预算。 */
+  | 'ticket/too-many-files'
+  /** 串行队列已满。 */
+  | 'ticket/busy'
+  /** 传输失败或中断（附远端 stderr 尾部）。 */
+  | 'ticket/sync-failed'
+  /** 条目含穿越路径、解压非零退出、或递归后条目数对不上。 */
+  | 'ticket/extract-failed'
+  /** 操作者取消，或连接断开后超过收尾时限。 */
+  | 'ticket/cancelled'
+
+/** 提交一次同步。`password` 缺省时回落到服务端配置的默认密码。 */
+export interface TicketSubmitRequest {
+  /** 工单号：`Q` + 13 位数字。 */
+  ticketId: string
+  /** zip 密码；只驻留内存，不落盘、不入日志。 */
+  password?: string
+}
+
+/** 提交结果：任务句柄与返回时刻的阶段（通常是 `queued`）。 */
+export interface TicketSubmitValue {
+  jobId: string
+  phase: TicketPhase
+}
+
+/** 密码预校验请求。 */
+export interface TicketVerifyRequest {
+  ticketId: string
+  password: string
+}
+
+/** 密码预校验结果。`reason` 只在 `ok=false` 且不是密码错误时出现。 */
+export interface TicketVerifyValue {
+  ok: boolean
+  reason?: 'no-archive' | 'archive-corrupt'
+}
+
+/** 取消结果。 */
+export interface TicketCancelValue {
+  outcome: 'requested' | 'already-finished'
+}
+
+/** 页面重进时的恢复视图。 */
+export interface TicketInspectValue {
+  /** 该工单最近一次仍未终态或已终态的任务（若有）。 */
+  job?: { jobId: string; phase: TicketPhase }
+  /** 仅当 `extract/` 已完整就位时给出绝对路径。 */
+  extractedPath?: string
+}
+
+/** 一个本地已占用工单的体积与最近使用时间。 */
+export interface TicketUsageRow {
+  ticketId: string
+  bytes: number
+  lastUsedAt: string
+}
+
+/** 容量治理快照。 */
+export interface TicketUsageValue {
+  tickets: TicketUsageRow[]
+}
+
+/** 删除结果。 */
+export interface TicketRemoveValue {
+  removed: boolean
+}
+
+/**
+ * 进度流的一帧。
+ *
+ * 首帧一定是 `status`（当前阶段快照），终态帧（`done`/`failed`）之后流正常关闭；
+ * 客户端据此把"流结束"与"任务成功"区分开 —— 流结束本身不代表成功。
+ */
+export type TicketFrame =
+  | { kind: 'status'; phase: TicketPhase; startedAt: string }
+  /** 同步器或解压器的输出尾部（限长，仅用于排障展示）。 */
+  | { kind: 'log'; chunk: string }
+  /** 字节进度；`total` 未知时客户端只显示已传量。 */
+  | { kind: 'progress'; bytes: number; total?: number; files: number }
+  | { kind: 'done'; extractedPath: string; bytes: number; durationMs: number }
+  | { kind: 'failed'; code: TicketErrorCode; message: string }
+
+/** 工单号的唯一权威格式：`Q` + 13 位 ASCII 数字。 */
+export const TICKET_ID_PATTERN = /^Q\d{13}$/
diff --git a/packages/api/ticket-sync/tests/extract.spec.ts b/packages/api/ticket-sync/tests/extract.spec.ts
new file mode 100644
index 00000000..8bda78a7
--- /dev/null
+++ b/packages/api/ticket-sync/tests/extract.spec.ts
@@ -0,0 +1,171 @@
+/**
+ * 解压器与帧流的回归测试：不需要构建，也不需要网络。
+ *
+ * 这些用例覆盖的是「会静默交付坏数据」或「会把分区写满」的路径，
+ * 因此断言的是**产物形态**（文件是否在预期位置、是否残留压缩包、
+ * 是否写了完成标记），而不是命令是否成功退出。
+ *
+ * 依赖宿主的 `zip`/`tar`：加密 zip 只能由 `zip -P` 生成（Node 侧没有
+ * 内置的 ZipCrypto 写入能力）。缺失时整组跳过，避免在精简 CI 镜像里误报。
+ */
+import { execFile } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import { mkdir, mkdtemp, readdir, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { promisify } from 'node:util'
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+import { ExtractError, extractToLeaf, isReady, promote } from '../src/extractor.ts'
+import type { ExtractLimits } from '../src/extractor.ts'
+import { TicketJob } from '../src/queue.ts'
+
+const exec = promisify(execFile)
+const PASSWORD = 'TestPass123'
+const TICKET = 'Q2026012500018'
+
+const dirs: string[] = []
+let workdir = ''
+let goodZip = ''
+let linkZip = ''
+let toolsReady = true
+
+/** 递归列出相对路径，用于断言产物形态。 */
+async function walk(dir: string, prefix = ''): Promise<string[]> {
+  const out: string[] = []
+  for (const entry of await readdir(dir, { withFileTypes: true })) {
+    const rel = prefix === '' ? entry.name : `${prefix}/${entry.name}`
+    if (entry.isDirectory()) out.push(...await walk(join(dir, entry.name), rel))
+    else out.push(rel)
+  }
+  return out.sort()
+}
+
+/** 造一个三层嵌套的加密工单包：zip → sp.tgz → cmd-output/*.tar.gz。 */
+async function buildGoodZip(root: string): Promise<string> {
+  const source = join(root, 'good')
+  const payload = join(root, 'payload')
+  await mkdir(join(source, 'sf/log'), { recursive: true })
+  await mkdir(join(source, 'cmd-output'), { recursive: true })
+  await mkdir(join(payload, 'sf/data/local/raidlog'), { recursive: true })
+  await writeFile(join(source, 'log_list.json'), '{"items":["/sf/log/boot.log"]}')
+  await writeFile(join(source, 'collect_record.txt'), 'record')
+  await writeFile(join(source, 'sf/log/boot.log'), 'boot ok')
+  await writeFile(join(payload, 'sf/data/local/raidlog/LOG_iostat.txt'), 'iostat body')
+  await exec('tar', ['-czf', join(source, 'cmd-output/log_slow_disk_1.tar.gz'), '-C', payload, 'sf'])
+  await exec('tar', ['-czf', join(source, 'sp_10.0.0.1.tgz'), '-C', source, 'sf', 'cmd-output'])
+  await exec('zip', ['-q', '-P', PASSWORD, '-r', join(root, `${TICKET}.zip`), '.'], { cwd: source })
+  return join(root, `${TICKET}.zip`)
+}
+
+/** 造一个含符号链接的包：解压前必须被拒绝，否则会写到 workspace 之外。 */
+async function buildLinkZip(root: string): Promise<string> {
+  const source = join(root, 'bad')
+  await mkdir(join(source, 'sf/log'), { recursive: true })
+  await exec('ln', ['-sf', '/etc/passwd', join(source, 'sf/log/evil')])
+  await writeFile(join(source, 'log_list.json'), '{}')
+  await exec('tar', ['-czf', join(source, 'sp_10.0.0.9.tgz'), '-C', source, 'sf'])
+  await exec('zip', ['-q', '-P', PASSWORD, '-r', join(root, 'Q2026012500019.zip'), '.'], { cwd: source })
+  return join(root, 'Q2026012500019.zip')
+}
+
+/** 默认限制：测试环境不设水位红线，只关心中间态。 */
+function limits(overrides: Partial<ExtractLimits> = {}): ExtractLimits {
+  return { maxExtractBytes: 1e9, minFreeBytes: 1, maxFiles: 50_000, maxDepth: 4, ...overrides }
+}
+
+beforeAll(async () => {
+  workdir = await mkdtemp(join(tmpdir(), 'ticket-extract-'))
+  dirs.push(workdir)
+  try {
+    await exec('zip', ['-v'])
+    await exec('tar', ['--version'])
+    goodZip = await buildGoodZip(workdir)
+    linkZip = await buildLinkZip(workdir)
+  } catch {
+    toolsReady = false
+  }
+})
+
+afterAll(async () => {
+  await Promise.all(dirs.splice(0).map(dir => rm(dir, { recursive: true, force: true })))
+})
+
+describe('extractToLeaf', () => {
+  it('递归解到叶子，且不残留压缩包', async () => {
+    if (!toolsReady) return
+    const target = join(workdir, 'out-1.tmp')
+    const layers: string[] = []
+    const result = await extractToLeaf(
+      goodZip,
+      target,
+      PASSWORD,
+      limits(),
+      new AbortController().signal,
+      info => layers.push(`L${String(info.depth)}:${info.archive}`),
+    )
+    const files = await walk(target)
+    expect(files).toContain('log_list.json')
+    expect(files).toContain('sp_10.0.0.1/sf/log/boot.log')
+    // 第三层：tgz 里的 cmd-output/*.tar.gz 必须继续展开，否则慢盘工单交付残缺目录
+    expect(files).toContain('sp_10.0.0.1/cmd-output/log_slow_disk_1/sf/data/local/raidlog/LOG_iostat.txt')
+    expect(files.some(file => file.endsWith('.tgz') || file.endsWith('.tar.gz'))).toBe(false)
+    expect(result.depth).toBeGreaterThanOrEqual(3)
+    expect(layers.length).toBeGreaterThanOrEqual(2)
+  })
+
+  it('就位后写 .ready 标记（workspace 只认这个标记）', async () => {
+    if (!toolsReady) return
+    const target = join(workdir, 'out-2')
+    await promote(join(workdir, 'out-1.tmp'), target)
+    expect(await isReady(target)).toBe(true)
+    expect(existsSync(join(target, '.ready'))).toBe(true)
+  })
+
+  it('含符号链接的归档在解压前被拒绝', async () => {
+    if (!toolsReady) return
+    const target = join(workdir, 'out-3.tmp')
+    await expect(extractToLeaf(
+      linkZip,
+      target,
+      PASSWORD,
+      limits(),
+      new AbortController().signal,
+      () => undefined,
+    )).rejects.toThrow(/链接/)
+  })
+
+  it('解压总量越过上限时报 space-exceeded 而不是返回半成品', async () => {
+    if (!toolsReady) return
+    const target = join(workdir, 'out-4.tmp')
+    await expect(extractToLeaf(
+      goodZip,
+      target,
+      PASSWORD,
+      limits({ maxExtractBytes: 10 }),
+      new AbortController().signal,
+      () => undefined,
+    )).rejects.toBeInstanceOf(ExtractError)
+  })
+})
+
+describe('TicketJob 帧流', () => {
+  /**
+   * 缓冲只保留 200 帧；用数组下标当游标会让订阅方在滑窗后永远停在窗口外，
+   * 表现是「进度卡住且收不到 done」。这里直接压 300 帧复现该边界。
+   */
+  it('滑窗后仍然能收到终态帧', async () => {
+    const job = new TicketJob('job-1', TICKET)
+    for (let index = 0; index < 300; index += 1) {
+      job.push({ kind: 'log', chunk: `line-${String(index)}` })
+    }
+    job.push({ kind: 'done', extractedPath: '/x', bytes: 1, durationMs: 1 })
+    job.finish('ready')
+
+    const kinds: string[] = []
+    for await (const frame of job.follow(new AbortController().signal)) {
+      kinds.push(frame.kind)
+      if (frame.kind === 'done') break
+    }
+    expect(kinds).toContain('done')
+  })
+})
diff --git a/packages/api/ticket-sync/tests/fixtures.ts b/packages/api/ticket-sync/tests/fixtures.ts
new file mode 100644
index 00000000..366d9211
--- /dev/null
+++ b/packages/api/ticket-sync/tests/fixtures.ts
@@ -0,0 +1,75 @@
+/**
+ * 归档 fixture 工厂：一次生成、进程内复用。
+ *
+ * 为什么不在每个用例里现造：造包要调 `zip -P`/`tar`，单个用例几十毫秒看起来
+ * 不多，但一旦想跑「改一行 → 立刻回归」的循环就会变成主要开销。这里用
+ * `beforeAll` 生成一次，并让多个 spec 共享同一份目录。
+ *
+ * 同时提供 `zipAvailable()`：加密 zip 只能由系统 `zip` 生成（Node 侧没有
+ * ZipCrypto 写入能力），精简镜像里缺这个二进制时整组用例应跳过而不是误报。
+ */
+import { execFile } from 'node:child_process'
+import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { promisify } from 'node:util'
+
+const exec = promisify(execFile)
+
+/** fixture 密码：与生产 Secret 无关，仅用于测试。 */
+export const PASSWORD = 'TestPass123'
+
+/** 一套 fixture 的绝对路径。 */
+export interface TicketFixtures {
+  /** 三层嵌套：zip → sp_*.tgz → cmd-output/*.tar.gz。 */
+  nested: string
+  /** tgz 内含指向 /etc/passwd 的符号链接。 */
+  link: string
+  /** 1 字节占位包（真实环境里存在）。 */
+  corrupt: string
+  /** 清理整个 fixture 根目录。 */
+  dispose: () => Promise<void>
+}
+
+/** 系统是否提供 zip（缺失时相关用例跳过）。 */
+export async function zipAvailable(): Promise<boolean> {
+  return exec('zip', ['-v']).then(() => true, () => false)
+}
+
+/**
+ * 生成全套 fixture。
+ * @returns 各包的绝对路径与清理函数。
+ */
+export async function buildTicketFixtures(): Promise<TicketFixtures> {
+  const root = await mkdtemp(join(tmpdir(), 'ticket-fixtures-'))
+
+  const good = join(root, 'good')
+  const payload = join(root, 'payload')
+  await mkdir(join(good, 'sf/log'), { recursive: true })
+  await mkdir(join(good, 'cmd-output'), { recursive: true })
+  await mkdir(join(payload, 'sf/data/local/raidlog'), { recursive: true })
+  await writeFile(join(good, 'log_list.json'), '{"items":["/sf/log/boot.log"]}')
+  await writeFile(join(good, 'collect_record.txt'), 'record')
+  await writeFile(join(good, 'sf/log/boot.log'), 'boot ok')
+  await writeFile(join(payload, 'sf/data/local/raidlog/LOG_iostat.txt'), 'iostat body')
+  await exec('tar', ['-czf', join(good, 'cmd-output/log_slow_disk_1.tar.gz'), '-C', payload, 'sf'])
+  await exec('tar', ['-czf', join(good, 'sp_10.0.0.1.tgz'), '-C', good, 'sf', 'cmd-output'])
+  await exec('zip', ['-q', '-P', PASSWORD, '-r', join(root, 'nested.zip'), '.'], { cwd: good })
+
+  const bad = join(root, 'bad')
+  await mkdir(join(bad, 'sf/log'), { recursive: true })
+  await exec('ln', ['-sf', '/etc/passwd', join(bad, 'sf/log/evil')])
+  await writeFile(join(bad, 'log_list.json'), '{}')
+  await exec('tar', ['-czf', join(bad, 'sp_10.0.0.9.tgz'), '-C', bad, 'sf'])
+  await exec('zip', ['-q', '-P', PASSWORD, '-r', join(root, 'link.zip'), '.'], { cwd: bad })
+
+  const corrupt = join(root, 'corrupt.zip')
+  await writeFile(corrupt, 'x')
+
+  return {
+    nested: join(root, 'nested.zip'),
+    link: join(root, 'link.zip'),
+    corrupt,
+    dispose: () => rm(root, { recursive: true, force: true }),
+  }
+}
diff --git a/packages/api/ticket-sync/tests/service.spec.ts b/packages/api/ticket-sync/tests/service.spec.ts
new file mode 100644
index 00000000..6e81f445
--- /dev/null
+++ b/packages/api/ticket-sync/tests/service.spec.ts
@@ -0,0 +1,128 @@
+/**
+ * 工单同步服务的宿主侧行为：入队、终态帧、错误分类与容量门槛。
+ *
+ * 故意不碰真实网络：`local` 同步器把"远端"换成本地目录 —— 目录里没有包
+ * 本身是一条有用的失败路径（not-found），而"包在但不该继续"的分支由缺密码
+ * 的用例覆盖。
+ */
+import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import { afterEach, describe, expect, it } from 'vitest'
+import TicketSyncService from '../src/index.ts'
+import type { Config } from '../src/index.ts'
+import type { TicketFrame } from '../src/types.ts'
+
+const TICKET = 'Q2026012500018'
+
+const contexts: Context[] = []
+const dirs: string[] = []
+
+afterEach(async () => {
+  await Promise.all(contexts.splice(0).map(ctx => ctx.fiber.dispose()))
+  await Promise.all(dirs.splice(0).map(dir => rm(dir, { recursive: true, force: true })))
+})
+
+/** 造一个用本地同步器的服务与它的临时根目录。 */
+async function fixture(overrides: Config = {}) {
+  const root = await mkdtemp(join(tmpdir(), 'ticket-sync-'))
+  dirs.push(root)
+  const ctx = new Context()
+  contexts.push(ctx)
+  const service = new TicketSyncService(ctx, {
+    syncer: 'local',
+    sourceDir: join(root, 'source'),
+    ticketsRoot: join(root, 'tickets'),
+    minFreeBytes: 0,
+    ...overrides,
+  })
+  return { ctx, service, root }
+}
+
+/**
+ * 收完一次任务的帧。
+ * @param service - 同步服务。
+ * @param jobId - 任务 id。
+ * @returns 服务端重放的全部帧（终态后流自动关闭）。
+ */
+async function drainFrames(service: TicketSyncService, jobId: string): Promise<TicketFrame[]> {
+  const job = service.jobOf(jobId)
+  if (job === undefined) throw new Error(`unknown job ${jobId}`)
+  const frames: TicketFrame[] = []
+  for await (const frame of job.follow(AbortSignal.timeout(10_000))) {
+    frames.push(frame)
+    if (frame.kind === 'done' || frame.kind === 'failed') break
+  }
+  return frames
+}
+
+describe('TicketSyncService 入队与终态', () => {
+  it('把远端缺失报成 not-found 终态帧，并让流在终态后关闭', async () => {
+    const { service } = await fixture()
+    const { jobId } = await service.submit({ ticketId: TICKET })
+    const frames = await drainFrames(service, jobId)
+    expect(frames.at(-1)).toMatchObject({ kind: 'failed', code: 'ticket/not-found' })
+    expect(service.jobOf(jobId)?.phase).toBe('failed')
+  })
+
+  it('失败的任务不会被复用：重试拿到的是一次新的执行', async () => {
+    const { service } = await fixture()
+    const first = await service.submit({ ticketId: TICKET })
+    await drainFrames(service, first.jobId)
+    const second = await service.submit({ ticketId: TICKET })
+    expect(second.jobId).not.toBe(first.jobId)
+    // 索引仍然指向最近一次执行，inspect 才不会读到旧结论。
+    expect(service.jobOfTicket(TICKET)?.id).toBe(second.jobId)
+  })
+
+  it('拒绝格式非法的工单号', async () => {
+    const { service } = await fixture()
+    await expect(service.submit({ ticketId: '../../etc' })).rejects.toMatchObject({ code: 'ticket/invalid-id' })
+  })
+
+  it('队列满时拒绝新工单而不是无限排队', async () => {
+    const { service } = await fixture({ queueLimit: 0 })
+    await expect(service.submit({ ticketId: TICKET })).rejects.toMatchObject({ code: 'ticket/busy' })
+  })
+
+  it('存储根不可写时在入队前就说清楚', async () => {
+    // 用一个普通文件当父目录：mkdir 会立刻 ENOTDIR，而不是依赖某个平台的
+    // 权限模型（/proc 之类的路径在不同环境里行为不一致，会把用例拖到超时）。
+    const root = await mkdtemp(join(tmpdir(), 'ticket-sync-'))
+    dirs.push(root)
+    await writeFile(join(root, 'blocker'), 'x')
+    const ctx = new Context()
+    contexts.push(ctx)
+    const service = new TicketSyncService(ctx, {
+      syncer: 'local',
+      sourceDir: join(root, 'source'),
+      ticketsRoot: join(root, 'blocker', 'tickets'),
+      minFreeBytes: 0,
+    })
+    await expect(service.submit({ ticketId: TICKET }))
+      .rejects.toMatchObject({ code: 'ticket/insufficient-storage' })
+  })
+
+  it('空存储根的空用量表不是错误', async () => {
+    const { service } = await fixture()
+    await expect(service.usage()).resolves.toEqual({ tickets: [] })
+  })
+
+  it('删除未知工单是幂等的空操作', async () => {
+    const { service } = await fixture()
+    await expect(service.remove(TICKET)).resolves.toEqual({ removed: false })
+  })
+})
+
+describe('TicketSyncService 失败分类', () => {
+  it('包已落地但没有可用密码时按 bad-password 失败', async () => {
+    const { service, root } = await fixture({ defaultPassword: '' })
+    const packageDir = join(root, 'source', TICKET)
+    await mkdir(packageDir, { recursive: true })
+    await mkdir(join(root, 'tickets'), { recursive: true })
+    await writeFile(join(packageDir, `${TICKET}.zip`), 'not a zip')
+    const { jobId } = await service.submit({ ticketId: TICKET })
+    expect((await drainFrames(service, jobId)).at(-1)).toMatchObject({ kind: 'failed', code: 'ticket/bad-password' })
+  })
+})
