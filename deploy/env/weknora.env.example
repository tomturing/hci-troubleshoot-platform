# WeKnora full（核心服务 + Neo4j + MinIO）本地环境模板。
# 复制为 deploy/env/weknora.env，并替换所有 change-me 值；该目标文件不应提交。

# 镜像可切换为私有镜像副本。UI 必须使用本项目的 /weknora/ 前缀构建镜像。
WEKNORA_UI_IMAGE=ghcr.io/tomturing/hci-troubleshoot-platform/weknora-ui:v0.9.0
# 自建 UI 镜像只有 linux/amd64（CI 单平台构建）。Apple Silicon 宿主必须显式钉平台，
# 否则 Compose 在 manifest 解析阶段就失败（no matching manifest for linux/arm64/v8）。
# 本地构建了原生 arm64 镜像时改成 linux/arm64。
WEKNORA_UI_PLATFORM=linux/amd64
WEKNORA_APP_IMAGE=wechatopenai/weknora-app:v0.9.0
WEKNORA_DOCREADER_IMAGE=wechatopenai/weknora-docreader:v0.9.0
WEKNORA_POSTGRES_IMAGE=paradedb/paradedb:v0.25.11-pg17
WEKNORA_REDIS_IMAGE=redis:7.0-alpine
WEKNORA_NEO4J_IMAGE=neo4j:2025.10.1
WEKNORA_MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

WEKNORA_DB_USER=postgres
WEKNORA_DB_PASSWORD=change-me-db-password
WEKNORA_DB_NAME=weknora
WEKNORA_REDIS_PASSWORD=change-me-redis-password
WEKNORA_JWT_SECRET=change-me-at-least-32-random-characters
# 必须恰好 32 字节；丢失后已加密的模型/API Key 无法恢复。
WEKNORA_SYSTEM_AES_KEY=change-me-exactly-32-byte-key!!!

WEKNORA_MINIO_ACCESS_KEY_ID=minioadmin
WEKNORA_MINIO_SECRET_ACCESS_KEY=change-me-minio-password
WEKNORA_MINIO_BUCKET_NAME=weknora
WEKNORA_MINIO_PATH_PREFIX=

# Neo4j 5+ 管理员用户名固定为 neo4j。
WEKNORA_NEO4J_USERNAME=neo4j
WEKNORA_NEO4J_PASSWORD=change-me-neo4j-password

WEKNORA_FRONTEND_PORT=18080
WEKNORA_APP_PORT=18081
WEKNORA_MINIO_PORT=19000
WEKNORA_MINIO_CONSOLE_PORT=19001
WEKNORA_NEO4J_HTTP_PORT=17474
WEKNORA_NEO4J_BOLT_PORT=17687
WEKNORA_MAX_FILE_SIZE_MB=50
