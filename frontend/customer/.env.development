# Customer UI 本地开发环境配置
#
# 开发环境网关（api-gateway）默认 INTERNAL_API_TOKEN = hci-dev-internal-token
# 对应 deploy/docker/docker-compose.yml 的 ${INTERNAL_API_TOKEN:-hci-dev-internal-token}
# 与 backend/api-gateway/app/config.py 的 INTERNAL_API_TOKEN 默认值一致
#
# 注意：本文件仅供本地 pnpm dev 使用，不进入生产构建（PROD 构建走 window.__HCI_AUTH__ 同源身份层）
VITE_DIAGNOSIS_TOKEN=hci-dev-internal-token
VITE_INTERNAL_API_TOKEN=hci-dev-internal-token
VITE_DIAGNOSIS_TENANT_ID=default
VITE_DIAGNOSIS_ACTOR_ID=dev-ui
