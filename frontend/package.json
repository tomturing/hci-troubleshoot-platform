{
  "name": "hci-troubleshoot-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "customer",
    "admin"
  ],
  "scripts": {
    "dev:customer": "npm -w customer run dev",
    "dev:admin": "npm -w admin run dev",
    "build:customer": "npm -w customer run build",
    "build:admin": "npm -w admin run build",
    "build": "npm -w customer run build && npm -w admin run build",
    "prepare": "git config core.hooksPath \"$(git rev-parse --show-toplevel)/scripts/git-hooks\" || true"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
