[Unit]
Description=HCI 工单日志同步服务
Documentation=docs/solution/events/2026-10-23-工单日志宿主机同步服务.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 硬要求：/sf/tickets 属主是 node:node，换其他身份要么写不进，要么 DSH 读不了。
User=node
Group=node
WorkingDirectory=/opt/hci-ticket-sync
EnvironmentFile=/etc/hci-ticket-sync/ticket-sync.env
# env 文件允许省略监听项（代码里有同名默认值），但 ExecStart 的 ${VAR} 展开
# 不会去看代码默认值，缺了就是空字符串。这里先给默认，env 文件可覆盖。
Environment=TICKET_LISTEN_HOST=192.168.0.4
Environment=TICKET_LISTEN_PORT=18080

# 重启不再无差别清空 .tmp：work_dir 按工单号固定，保住已下载的归档才能让
# rsync --partial 续传——否则一个 65 GiB 的包失败一次就要从 0 重拉几十 GiB。
# 只回收 2 小时未更新的残留，与代码里的 STALE_WORKSPACE_SECONDS 保持一致；
# 正在下载的目录 mtime 一直在被刷新，不会被误删。
ExecStartPre=/bin/sh -c 'find /sf/tickets/.tmp -mindepth 1 -maxdepth 1 -mmin +120 -exec rm -rf {} + 2>/dev/null || true'

# $TICKET_LISTEN_HOST / $TICKET_LISTEN_PORT 由 EnvironmentFile 提供。
ExecStart=/opt/hci-ticket-sync/.venv/bin/uvicorn app.main:app \
    --host ${TICKET_LISTEN_HOST} \
    --port ${TICKET_LISTEN_PORT} \
    --no-access-log

Restart=always
RestartSec=3

# 服务只需要写 /sf/tickets 与读配置，不需要任何提权能力。
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
