# 工单日志同步服务配置模板（无 root 的 user unit 使用）
#
# 安装位置：~/.config/hci-ticket-sync/ticket-sync.env（600）
# 该文件只存在于宿主机，不入库、不进集群 Secret、不进镜像。
# 归档密码请向运维索取后填入，不要把真实密码写回仓库。

TICKET_SOURCE_HOST=192.168.0.2
TICKET_SOURCE_PORT=22468
TICKET_SOURCE_USER=acli
TICKET_SSH_KEY=/home/node/.ssh/id_ed25519
TICKET_ARCHIVE_PASSWORD=
TICKET_ROOT=/sf/tickets

# 后台自动扫描日志源服务器并同步最近若干天的归档；每 30 秒检查一次。
TICKET_AUTO_SYNC_ENABLED=true
TICKET_AUTO_SYNC_INTERVAL_SECONDS=30
# 失败任务回看窗口（天）。常规扫描只看当天；这个窗口只用于找回失败过的工单，
# 不会把窗口内的历史归档全部补拉一遍。
TICKET_AUTO_SCAN_DAYS=7
# 本地保留天数。判据是「同步完成时刻」，不是工单号里的日期——客户可能隔几天
# 再上传历史工单，按工单号日期算会把它判成早已过期。
# 远端 /sf/log 保留期远大于 7 天且有独立备份，本地删掉后可随时重拉。
# 清理每 30 秒执行一轮（不是每天一次），删除动作会写入 cleanup_events 表。
TICKET_RETENTION_DAYS=3
# 容量淘汰的最短保留天数。必须小于 TICKET_RETENTION_DAYS，否则淘汰会抢在
# 保留期之前删完，保留期永远删 0 个（实测过期删除计数恒为 0）。
TICKET_MIN_KEEP_DAYS=1

# ── 磁盘水位双阈值（必须满足：EVICT > MIN，否则服务拒绝启动）──
# 硬阈值：剩余空间低于它直接拒绝新任务，一个字节都不写。
# 250 GiB = kubelet 驱逐线 107 GiB + 单任务峰值 90 GiB + 安全边际 53 GiB。
TICKET_MIN_FREE_BYTES=268435456000
# 软阈值：剩余空间低于它就主动淘汰最旧产物，把余量拉回阈值之上。
# 400 GiB = 硬阈值 250 + 一轮淘汰需腾出的 150 GiB。
TICKET_EVICT_FREE_BYTES=429496729600

# 其余项留空即用代码默认值（192.168.0.4:18080、20GiB 上限、并发 2 等），
# 需要覆盖时取消注释：
# TICKET_LISTEN_HOST=192.168.0.4
# TICKET_LISTEN_PORT=18080
# TICKET_MAX_ARCHIVE_BYTES=21474836480
# TICKET_MAX_TOTAL_BYTES=1099511627776
# TICKET_CONCURRENCY=2
