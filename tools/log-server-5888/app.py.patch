+def _latest_archived(filename):
+    """只读地找该工单最新归档件；会话被 24h reaper 清掉后靠它兜底。
+
+    与 ``archive_status`` 同一套命名规则：同名件或 ``{工单号}-{时间戳}.zip``，
+    取 mtime 最新。绝不写文件、绝不现算摘要（大包逐字节读会拖垮上传）。
+    """
+    case_id = filename[: -len('.zip')]
+    case_dir = os.path.join(UPLOAD_FOLDER, case_id)
+    if not os.path.isdir(case_dir):
+        return None
+    candidates = []
+    try:
+        for name in os.listdir(case_dir):
+            if name == filename or (name.startswith(case_id + '-') and name.endswith('.zip')):
+                path = os.path.join(case_dir, name)
+                if os.path.isfile(path):
+                    candidates.append(path)
+    except OSError:
+        return None
+    if not candidates:
+        return None
+    latest = max(candidates, key=lambda p: os.path.getmtime(p))
+    try:
+        stat = os.stat(latest)
+    except OSError:
+        return None
+    return {
+        'path': latest,
+        'size': stat.st_size,
+        'mtime_iso': _unix_to_utc_iso(stat.st_mtime),
+    }
+
